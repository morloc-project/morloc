-- Daemon-mode regression for the @stdout claim wedge.
--
-- @collect wires a @stdout OStream into `produce*` inside the language
-- pool. A daemon refuses such a call before it runs; `rawStdout` opens
-- @stdout itself, which only the pool-side open refuses (DAEMON-15).
--
-- A daemon reuses one pool and one registry across every call, so a claim
-- left behind by a refused open would make every later open fail "@stdout
-- already open in this nexus" instead of being refused. @stderr still opens
-- in a daemon: `leakStderr` raises with it open, and the per-call reclaim
-- must release it for `useStderr`. A one-shot golden cannot show either:
-- each run gets a fresh registry.

module main (useStdout, rawStdout, useStderr, leakStderr)

import root-py

source Py from "stdio-wedge.py" ("mk")

mk :: Int -> [Int]

produceOk :: ([Int] -> <IO> ()) -> <IO> ()
produceOk sink = do
  _ <- sink (mk 1)
  sink (mk 2)

useStdout :: <IO> ()
useStdout = @collect produceOk

rawStdout :: <IO> ()
rawStdout = do
  o <- @stdout :: <IO> OStream Int
  @write 0 o (mk 1)
  @close o

useStderr :: <IO> Int
useStderr = do
  e <- @stderr :: <IO> OStream Int
  @write 0 e (mk 1)
  @close e
  1

leakStderr :: <IO> Int
leakStderr = do
  e <- @stderr :: <IO> OStream Int
  @write 0 e (mk 1)
  @throw "leak: failed with @stderr open"

