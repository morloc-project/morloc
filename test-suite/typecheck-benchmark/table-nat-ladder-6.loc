module tl6 (top)

type Table (n :: Nat) (r :: Rec)

nrow :: Table n r -> Int
sliceRows :: Int -> Int -> Table n r -> Table m r

p0 :: Int -> Table m {a = Real, b = Real, c = Real, d = Real, e = Real, f = Real, g = Real, h = Real}
p1 :: Int -> Table m {a = Real, b = Real, c = Real, d = Real, e = Real, f = Real, g = Real, h = Real}
p1 n = sliceRows 0 (nrow (p0 n)) (p0 n)
p2 :: Int -> Table m {a = Real, b = Real, c = Real, d = Real, e = Real, f = Real, g = Real, h = Real}
p2 n = sliceRows 0 (nrow (p1 n)) (p1 n)
p3 :: Int -> Table m {a = Real, b = Real, c = Real, d = Real, e = Real, f = Real, g = Real, h = Real}
p3 n = sliceRows 0 (nrow (p2 n)) (p2 n)
p4 :: Int -> Table m {a = Real, b = Real, c = Real, d = Real, e = Real, f = Real, g = Real, h = Real}
p4 n = sliceRows 0 (nrow (p3 n)) (p3 n)
p5 :: Int -> Table m {a = Real, b = Real, c = Real, d = Real, e = Real, f = Real, g = Real, h = Real}
p5 n = sliceRows 0 (nrow (p4 n)) (p4 n)
p6 :: Int -> Table m {a = Real, b = Real, c = Real, d = Real, e = Real, f = Real, g = Real, h = Real}
p6 n = sliceRows 0 (nrow (p5 n)) (p5 n)

top :: Int -> Int
top n = nrow (p6 n)
