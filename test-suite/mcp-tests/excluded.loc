--' MCP tool-surface coverage (no special dependencies).
--'
--' A command whose input may come from stdin is served, with that input
--' required: a call off the command line has no stdin (IFACE-3). `plainAdd`
--' is the control.
module main
  ( plainAdd
  , readStdin
  )

import root-py

source Py from "excluded.py" ("add2")

add2 :: Int -> Int -> Int

--' A normal command (control: MUST appear in tools/list)
plainAdd :: Int -> Int -> Int
plainAdd x y = add2 x y

--' Reads integers from a file OR stdin
readStdin ::
  --' @stdin true
  --' @metavar FILE
  Str ->
  <IO> [Int]
readStdin f = do
  Ok fi <- (@open f :: <IO> (Try Str (IStream Int)))
  Ok xs <- @next fi
  xs
