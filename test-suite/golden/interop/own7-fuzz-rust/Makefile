	echo "p142 $$(./oracle p142 7 2 2>> oracle.err || echo failed)" >> oracle.txt
	echo "p143 $$(./oracle p143 7 2 2>> oracle.err || echo failed)" >> oracle.txt
	echo "p144 $$(./oracle p144 7 1 2>> oracle.err || echo failed)" >> oracle.txt
	echo "p145 $$(./oracle p145 7 1 2>> oracle.err || echo failed)" >> oracle.txt
	echo "p146 $$(./oracle p146 7 3 2>> oracle.err || echo failed)" >> oracle.txt
	echo "p147 $$(./oracle p147 7 1 2>> oracle.err || echo failed)" >> oracle.txt
	echo "p148 $$(./oracle p148 7 0 2>> oracle.err || echo failed)" >> oracle.txt
	echo "p149 $$(./oracle p149 7 3 2>> oracle.err || echo failed)" >> oracle.txt

clean:
	rm -rf nexus oracle asan pools __pycache__ *-build *build.tmp*
	rm -f *.err run.txt asan.txt
