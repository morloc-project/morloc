p148g0 j x = (let a = keyp (.0 (.t x)) + .1 (.t x) + .w x in ? j > 9 = x : {t = (mkp 0, 0), w = 0})
p148 :: Int -> Int -> (Int, Int)
p148 n j = census ((let x = {t = (mkp n, 1), w = 2} in (\x -> keyp (.0 (.t x)) + .1 (.t x) + .w x) (p148g0 j (x)) + (\x -> keyp (.0 (.t x)) + .1 (.t x) + .w x) (p148g0 j (x))))

-- p149: kind T
--   caller nested, j=3
--   p149g0: keep
p149g0 :: Int -> (Pay, Int) -> (Pay, Int)
p149g0 j x = ? j > 0 = x : (mkp 0, 0)
--   p149g1: keep
p149g1 :: Int -> (Pay, Int) -> (Pay, Int)
p149g1 j x = ? j > 0 = x : (mkp 0, 0)
--   p149g2: passKeep
p149g2 :: Int -> (Pay, Int) -> (Pay, Int)
p149g2 j x = ? j > 1 = p149g1 (j - 1) x : x
p149 :: Int -> Int -> (Int, Int)
p149 n j = census ((\x -> keyp (.0 x) + .1 x) (p149g2 j (p149g1 j (p149g0 j (p149g2 j (p149g1 j (p149g0 j ((mkp n, 1)))))))))
