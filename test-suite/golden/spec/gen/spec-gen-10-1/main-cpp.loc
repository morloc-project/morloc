-- GEN-10: a generated record whose field names a type from a sourced file
-- (`Wrap` holds the user's `Point`) is defined only inside the pool, after
-- the sourced files, as is one with no module to be generated in (`Rec`,
-- named like a type the compiler defines). Both are built and cross to
-- Python and back; `morloc types` leaves them out and says so, while a
-- record with no such field (`Plain`) is written. The Rust twin is
-- main-rust.loc.
module main (roundWrap, roundRec, roundPlain)

import root-cpp
import root-py

record Point where
  x :: Int
  y :: Int
record Cpp => Point = "Point"

record Wrap where
  p :: Point
  tag :: Str

record Rec where
  v :: Int

record Plain where
  w :: Int

source Cpp from "gen10.hpp" ("mkPoint", "idn")
mkPoint :: Int -> Point
idn :: a -> a

source Py from "gen10.py" ("pyid")
pyid :: a -> a

roundWrap :: Int -> Wrap
roundWrap n = pyid {p = mkPoint n, tag = "t"}

roundRec :: Int -> Rec
roundRec n = pyid (idn {v = n})

roundPlain :: Int -> Plain
roundPlain n = pyid (idn {w = n})
