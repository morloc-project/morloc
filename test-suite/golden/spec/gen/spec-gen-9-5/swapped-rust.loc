-- A recursive parameterized record referring to itself at other arguments
-- (`T b a` in `T a b`) is generated and round trips.
module main (trip)

import root-rust

record T a b where
  val :: a
  sub :: ?(T b a)

source Rust from "s.rs" ("same")
same :: a -> a

trip :: T Int Str -> T Int Str
trip x = same x
