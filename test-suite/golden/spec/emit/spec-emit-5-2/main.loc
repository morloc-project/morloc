stopAnd :: Bool -> Bool -> Bool
stopAnd a b = a && b && a && (@throw "evaluated past a False")

stopOr :: Bool -> Bool -> Bool
stopOr a b = a || b || a || (@throw "evaluated past a True")

pickThrow :: Bool -> Bool -> Int
pickThrow a b
  ? a = 1
  : ? b = @throw "second arm"
  : ? a = 2
  : 3

