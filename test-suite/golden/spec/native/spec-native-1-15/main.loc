-- NATIVE-1: a newtype with a form of its own is spelled at its own
-- arguments, never at those of the record it wraps: `Point` (no
-- parameters, over `Pair Tenths`) is `point_t` alone and in containers,
-- and `W Tenths` (over `Pair (Tenths, Tenths)`) is `w_t<double>`, both
-- received from and returned to the wire.
module main (readPt, mkPt, readPts, readOpt, readW)

import root-cpp

newtype Tenths = Int
type Cpp => Tenths = "double"

instance Packable Int Tenths where
  source Cpp from "p.hpp" ("packTenths" as pack, "unpackTenths" as unpack)

record Pair a where
  fst :: a
  snd :: a
record Cpp => Pair a = "pair_t<$1>" a

newtype Point = Pair Tenths
type Cpp => Point = "point_t"

newtype W a = Pair (a, a)
type Cpp => W a = "w_t<$1>" a

source Cpp from "p.hpp" ("readPt", "mkPt", "readPts", "readOpt", "readW")
readPt :: Point -> Int
mkPt :: Int -> Point
readPts :: [Point] -> Int
readOpt :: ?Point -> Int
readW :: W Tenths -> Int
