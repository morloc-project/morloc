-- The instance by a source.
module sourced (run, direct)
import root

type Py => Int = "int"
type Py => I64 = "int"
type Py => (List a) = "list" a
type Py => (Optional a) = "Optional" a

record R where
  x :: Int

source Py from "h.py" ("h_rev" as rev)
rev :: [a] -> [a]

instance Sliceable List where
  source Py from "h.py" ("h_slice" as __get_slice__)
instance IndexLike (?I64) where
  source Py from "h.py" ("h_id" as __to_index__)

instance Functor List where
  source Py from "h.py" ("h_rev_map" as map)

run :: [R] -> [Int]
run xs = .[:].x xs

direct :: [R] -> [Int]
direct xs = map (\r -> .x r) xs
