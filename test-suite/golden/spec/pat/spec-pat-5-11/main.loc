-- A bracket on a receiver that is not a list on the wire reaches it only
-- through its instance, which runs in a pool (PAT-5). This instance has no
-- implementation in any pool. The nexus evaluator brackets lists natively and
-- must refuse anything else rather than read the receiver as a list.

module main (first)

import root-py

newtype Two a = (a, a)

instance Indexable Two

first :: Two Int -> Int
first p = .[0] p
