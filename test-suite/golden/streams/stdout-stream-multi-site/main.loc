-- Two producers sharing one `@collect` sink must produce well-formed output
-- in every stream format. Under `-f packet` the run's stdout is one stream
-- packet (header once, one final footer indexing every sub-packet) that a
-- later command can read back whole. Under `-f json` the stream is one
-- array; jsonl needs no framing (issue #114).

module main (twoSites, total)

import root-py

source Py from "impl.py" ("mk", "total")

mk :: Int -> [Int]
total :: [Int] -> Int

produce :: Int -> ([Int] -> <IO> ()) -> <IO> ()
produce n sink = sink (mk n)

twoSites :: <IO> (Collect Int)
twoSites = @collect (\k -> do
  _ <- produce 1 k
  produce 2 k)
