-- Daemon-mode regression for the @stdout claim wedge.
--
-- Both stdout sources return `Collect` (STRM-7), so a daemon refuses
-- `useStdout` (@collect) and `rawStdout` (@stdout) before they run, every
-- time, never as "@stdout already open in this nexus". @stderr still opens
-- in a daemon: `leakStderr` raises with it open, and the per-call reclaim
-- must release it for `useStderr`. A one-shot golden cannot show either:
-- each run gets a fresh registry.

module main (useStdout, rawStdout, useStderr, leakStderr)

import root-py

source Py from "stdio-wedge.py" ("mk")

mk :: Int -> [Int]

produceOk :: ([Int] -> <IO> ()) -> <IO> ()
produceOk sink = do
  _ <- sink (mk 1)
  sink (mk 2)

useStdout :: <IO> (Collect Int)
useStdout = @collect produceOk

rawStdout :: <IO> (Collect Int)
rawStdout = @stdout (\o -> do
  @write 0 o (mk 1))

useStderr :: <IO> Int
useStderr = do
  e <- @stderr :: <IO> OStream Int
  @write 0 e (mk 1)
  @close e
  1

leakStderr :: <IO> Int
leakStderr = do
  e <- @stderr :: <IO> OStream Int
  @write 0 e (mk 1)
  @throw "leak: failed with @stderr open"

