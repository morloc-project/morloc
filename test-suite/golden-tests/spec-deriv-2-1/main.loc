-- Spec DERIV-2: derived Eq, Ord, Show and Hashable act on the wire value,
-- with the same results in every language.
module main (checks, texts)

import root-py

newtype Name = Str
  deriving (Eq, Ord, Show, Hashable)

data Shape = Circle Real | Rect Real Real | Dot
  deriving (Eq, Ord, Show)

record Point
  deriving (Eq, Ord, Show)
  where
  x :: Int
  y :: Int
record Py => Point = "dict"

checks :: [Bool]
checks =
  [ (idpy ("ab" :: Name)) == ("ab" :: Name)
  , (idpy ("ab" :: Name)) < ("b" :: Name)
  , (idpy (Circle 1.0)) == Circle 1.0
  , (idpy (Rect 1.0 2.0)) < Rect 1.0 1.0
  , (idpy Dot) > Circle 5.0
  , (idpy ({x = 1, y = 2} :: Point)) < ({x = 1, y = 3} :: Point)
  ]

texts :: [Str]
texts =
  [ show (idpy ("ab" :: Name))
  , show (idpy (Rect 1.0 2.0))
  , hash (idpy ("ab" :: Name))
  ]
