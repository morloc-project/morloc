module main (mapTwice)

import root-rust

source Rust from "own.rs" ("inc" as inc)
inc :: Int -> Int

-- `f` is a single closure value bound once, then passed to `map` at two call
-- sites. lcSourcedArg passes a function argument BY VALUE (a HOF takes it as
-- `F: Fn`), and an `impl Fn` closure is not Copy, so the second `map f ys` uses
-- the moved `f` -- a rustc E0382. `morloc_map_vec(f, ..)` takes `f` by value, so
-- the fan-out is a genuine double-move; the isVar disambiguation that would
-- borrow a value-typed argument only fires at sourced-call sites, not here.
-- Importing only root-rust keeps the Functor List instance Rust-only, so both
-- maps and the shared closure realize in the Rust pool.
mapTwice :: [Int] -> [Int] -> ([Int], [Int])
mapTwice xs ys =
  let f = (\x -> inc x)
  in (map f xs, map f ys)
