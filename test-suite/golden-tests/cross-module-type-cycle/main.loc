-- A type-alias cycle spanning two modules must be rejected by the
-- frontend, not hang the compiler in a reduce-and-retry loop
-- (Realize.handleMany, the expand cases in Express.hs, the alias-chase in
-- pairEval) that walks A -> ABody -> A forever. A type name resolves only
-- to a declaration its module declares or imports, so such a cycle needs
-- the two modules to import each other, and the import cycle is reported.

module main (fooLiteral, fooTuple, fooList, fooRecord)
import root
import .modA
import .modB

-- Each binding triggers a different reduce-and-retry codepath that
-- would loop under the pre-fix compiler:
--   * fooLiteral  -- Realize.handleMany (any literal at the cycle type)
--   * fooTuple    -- Express.expressCore TupS expand
--   * fooList     -- Express.expressCore LstS expand
--   * fooRecord   -- Express.expressCore NamS expand
-- After the fix, the frontend rejects the program before reaching
-- any of these sites, so we only need to assert the error fires.

fooLiteral :: A
fooLiteral = 42

fooTuple :: A
fooTuple = (1, 2)

fooList :: A
fooList = [1, 2, 3]

fooRecord :: A
fooRecord = {x = 1}
