-- A function value chosen at run time cannot be specialized away, so it
-- reaches a sourced function that needs `Sync` as a function value, which
-- must be shareable between threads.

module dynamic (pick)

import root-rust

source Rust from "lib.rs" ("par_map" as parMap)
parMap :: (Int -> Int) -> [Int] -> [Int]

double :: Int -> Int
double x = x * 2

triple :: Int -> Int
triple x = x * 3

loopF :: (Int -> Int) -> Int -> [Int] -> <IO> [Int]
loopF f k xs = ? k == 0 = do
    xs
  : loopF f (k - 1) (parMap f xs)

pick :: Bool -> [Int] -> <IO> [Int]
pick b xs = loopF (? b = double : triple) 1 xs
