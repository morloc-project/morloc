-- A data-writing intrinsic (@savem here, also @save, @savej, @write)
-- writes data, and a suspension or a function is not data: it is a
-- closure whose manifold id means nothing outside this build. The build
-- refuses the write in every backend rather than letting the pool fail
-- at run time. Running the suspension first (`v <- get 1`) and writing
-- the value is the intended form.
module main (saved)

import root
import root-py

source Py from "lib.py" ("get")
get :: Int -> <IO> Int

saved :: Str -> <IO> Int
saved path = do
  v <- get 41
  @savem path v
  Ok w <- @load path
  do (w + 1)
