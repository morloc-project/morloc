-- @streamLayout: per-sub-packet layout of an indexed IFile, for parallel planning.
--
-- @streamLayout :: IFile [a] -> <IO> [(U64, U64, U64)]
--   returns one (elementOffset, elementCount, uncompressedSize) triple per
--   sub-packet, in file order. A DATA packet is the degenerate single-chunk
--   case. The layout is derived at read time from the sub-packet index and
--   the per-sub-packet headers (no wire-format change, no decompression).
--
-- The C++ projections below pull out the deterministic fields (elementOffset,
-- elementCount) so the expected output is stable. Sourcing them also drives
-- the layout through the C++ pool's `_mlc_stream_layout` wrapper end-to-end.
-- uncompressedSize is byte-size dependent (not asserted here); its computation
-- is exercised by the parallelization case study.

module main
  ( offsets
  , counts
  , numChunks
  , totalElems
  , dataOffsets
  , dataCounts
  )

import root
import root-cpp

source Cpp from "proj.hpp" ("projOffsets", "projCounts", "chunkCount")
projOffsets :: [(U64, U64, U64)] -> [U64]
projCounts :: [(U64, U64, U64)] -> [U64]
chunkCount :: [(U64, U64, U64)] -> Int

-- Write three sub-packets (element counts 3, 4, 1) and reopen as an IFile.
openThree :: Str -> <IO> IFile [Int]
openThree path = do
  Ok o <- @open path :: <IO> (Try Str (OStream Int))
  @write 0 o [1, 2, 3]
  @flush o
  @write 0 o [4, 5, 6, 7]
  @flush o
  @write 0 o [8]
  @close o
  Ok _tailv97 <- @open path :: <IO> (Try Str (IFile [Int]))
  _tailv97

offsets :: Str -> <IO> [U64]
offsets path = do
  f <- openThree path
  Ok layout <- @streamLayout f
  projOffsets layout

counts :: Str -> <IO> [U64]
counts path = do
  f <- openThree path
  Ok layout <- @streamLayout f
  projCounts layout

numChunks :: Str -> <IO> Int
numChunks path = do
  f <- openThree path
  Ok layout <- @streamLayout f
  chunkCount layout

totalElems :: Str -> <IO> Int
totalElems path = do
  f <- openThree path
  Ok _tailv98 <- @flen f
  _tailv98

-- DATA-packet single-chunk case: a monolithic @save'd list opens as an
-- IFile whose layout is exactly one triple (offset 0, count = #elements).
openData :: Str -> <IO> IFile [Int]
openData path = do
  @save 0 path [10, 20, 30, 40]
  Ok _tailv99 <- @open path :: <IO> (Try Str (IFile [Int]))
  _tailv99

dataOffsets :: Str -> <IO> [U64]
dataOffsets path = do
  f <- openData path
  Ok layout <- @streamLayout f
  projOffsets layout

dataCounts :: Str -> <IO> [U64]
dataCounts path = do
  f <- openData path
  Ok layout <- @streamLayout f
  projCounts layout
