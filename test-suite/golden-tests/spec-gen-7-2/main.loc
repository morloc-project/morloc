-- GEN-7: a generated record whose field names a dependency's type
-- (`nlohmann::json`, declared with namespace and import in cpp-deps) is
-- written to the public header, which includes the dependency's header and
-- which a source names.
module main (keys)

import root-cpp

newtype Json = Str
type Cpp => Json = "nlohmann::json"

instance Packable Str Json where
  source Cpp from "pk.hpp" ("parseJson" as pack, "dumpJson" as unpack)

record Doc where
  body :: Json
  tag :: Str

source Cpp from "f.hpp" ("keys")
keys :: Doc -> Int
