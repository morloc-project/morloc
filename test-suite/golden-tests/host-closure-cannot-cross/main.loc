-- A function value that HOST code created has no identity to send across a
-- pool boundary: the wire form of a closure is the manifold to call back
-- into, and a host's callable is not one. Re-running the call that produced
-- it is not an option either -- that call is effectful, so running it again
-- would run its effects again. The value may be applied in the pool that
-- received it (`localOk`); handing it to another pool (`crossesPools`, in
-- bad.loc) is refused at build (HOST-9), naming the function.
module main (localOk)

import root-py
import root-cpp

type Cpp => Int = "int"

source Py from "hosts.py" ("mk_adder" as mkAdder, "use_pure" as usePurePy)
source Cpp from "hosts.hpp" ("use_pure" as usePureCpp)

--' a Python host that returns a function value
mkAdder :: Int -> <IO> (Int -> Int)
usePurePy :: (Int -> Int) -> Int -> Int
usePureCpp :: (Int -> Int) -> Int -> Int

--' applying it in the pool that received it is legal
localOk :: Int -> <IO> Int
localOk k = do
  f <- mkAdder k
  usePurePy f 2
