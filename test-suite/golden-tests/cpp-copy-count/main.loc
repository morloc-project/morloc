module main (run, runWrite, runParts)

import root
import root-cpp

-- Counts the whole-batch copies a C++ pool makes when a tail loop hands each
-- batch through @try and a capturing sink, as a stream drain does. A copy of
-- a batch allocates it anew and a move does not, so the count of large heap
-- allocations per batch is the number of times a batch is built or copied.
-- The sink also captures a large list, so copying the sink shows up too.
--
-- Four per batch: the batch is built once, then copied into the sink's
-- by-value parameter, into the suspension the sink returns, and the sink's
-- captured list is copied into that suspension. Taking a parameter used once
-- by value (and moving the caller's last use into it) would remove the two
-- batch copies; holding captures in shared storage would remove the third.
--
-- `runWrite` writes each batch to a stream file. `@write` runs as a @try
-- thunk that `_mlc_try` calls in place, so it reads the batch where it is:
-- one per batch, the batch itself.
--
-- `runParts` turns each `Try` into a `(Bool, Str, [Int])` through a match,
-- as the parallel library's `pullParts` does. The tuple moves out of the
-- match's arms rather than being copied at each; four per batch remain: the
-- batch, the tuple built from the `Try`'s payload (which may be shared, so is
-- copied), and the projection and suspension copies the sink loop above has.
--
-- Large allocations per batch, as the difference between runs of N1 and N2
-- batches (fixed setup cancels). One is the batch being built; every further
-- one is a copy.

source Cpp from "count.hpp" ("makeBatch", "recordBatch", "bigAllocs", "makeExtra")

makeBatch :: Int -> <IO> [Int]
recordBatch :: [Int] -> [Int] -> <IO> ()
makeExtra :: Int -> [Int]
bigAllocs :: Int -> <IO> Int

drainT :: ([Int] -> <IO> ()) -> Int -> <IO> ()
drainT sink n = do
  Ok xs <- @try (makeBatch n)
  ? n == 0 = do
      ()
  : do
    sink xs
    drainT sink (n - 1)

--' Drain n batches; return the count of large allocations
run :: Int -> Int -> <IO> Int
run k n = do
  drainT (\xs -> recordBatch extra xs) n
  bigAllocs n
  where
    extra = makeExtra k

writeDrain :: OStream Int -> Int -> <IO> ()
writeDrain o n = do
  ? n == 0 = do
      ()
  : do
    xs <- makeBatch n
    Ok u <- @write 0 o xs
    writeDrain o (n - 1)

--' Write n batches to a stream file; return the large-allocation count
runWrite :: Str -> Int -> <IO> Int
runWrite path n = do
  Ok o <- @open path :: <IO> (Try Str (OStream Int))
  writeDrain o n
  @close o
  bigAllocs n

parts :: <IO> (Try Str [Int]) -> <IO> (Bool, Str, [Int])
parts pull = do
  r <- pull
  match r
    | (Err e) = (False, e, [])
    | (Ok xs) = (True, "", xs)

partsDrain :: [Int] -> Int -> <IO> ()
partsDrain extra n = do
  ? n == 0 = do
      ()
  : do
    p <- parts (@try (makeBatch n))
    recordBatch extra (.2 p)
    partsDrain extra (n - 1)

--' Drain n batches through a Try-to-tuple match; return the large-allocation count
runParts :: Int -> Int -> <IO> Int
runParts k n = do
  partsDrain (makeExtra k) n
  bigAllocs n
