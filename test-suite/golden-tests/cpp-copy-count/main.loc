module main (run, runWrite, runParts, runSingle)

import root
import root-cpp

-- Counts the whole-batch copies a C++ pool makes when a tail loop hands each
-- batch through @try and a capturing sink, as a stream drain does. A copy of
-- a batch allocates it anew and a move does not, so the count of large heap
-- allocations per batch is the number of times a batch is built or copied.
-- The sink also captures a large list, so copying the sink shows up too.
--
-- Three per batch: the batch is built once, the sink, which takes it by
-- reference (OWN-7), copies it into the suspension it returns, and the
-- sink's captured list is copied into that suspension. Taking a kept
-- parameter by value in a closure, or holding captures in shared storage,
-- would remove the copies.
--
-- `runWrite` writes each batch to a stream file. `@write` runs as a @try
-- thunk that `_mlc_try` calls in place, so it reads the batch where it is:
-- one per batch, the batch itself.
--
-- `runParts` turns each `Try` into a `(Bool, Str, [Int])` through a match,
-- as the parallel library's `pullParts` does. The tuple moves out of the
-- match's arms rather than being copied at each, and the batch moves out of
-- the tuple (OWN-5), and the `Try`'s payload moves out of its arm, which
-- nothing else holds (CPP-6); two per batch remain: the batch and the
-- suspension copy the sink loop above has.
--
-- `runSingle` puts each batch, at its last use, into a one-element list.
-- Two per batch: the batch, and a copy of `extra` taken by the thunk that
-- runs the effectful `recordBatches` call (codegen-copies.md).
--
-- Large allocations per batch, as the difference between runs of N1 and N2
-- batches (fixed setup cancels). One is the batch being built; every further
-- one is a copy.

source Cpp from "count.hpp" ("makeBatch", "recordBatch", "bigAllocs", "makeExtra", "recordBatches")

makeBatch :: Int -> <IO> [Int]
recordBatch :: [Int] -> [Int] -> <IO> ()
makeExtra :: Int -> [Int]
bigAllocs :: Int -> <IO> Int
recordBatches :: [Int] -> [[Int]] -> <IO> ()

drainT :: ([Int] -> <IO> ()) -> Int -> <IO> ()
drainT sink n = do
  Ok xs <- @try (makeBatch n)
  ? n == 0 = do
      ()
  : do
    sink xs
    drainT sink (n - 1)

--' Drain n batches; return the count of large allocations
run :: Int -> Int -> <IO> Int
run k n = do
  drainT (\xs -> recordBatch extra xs) n
  bigAllocs n
  where
    extra = makeExtra k

writeDrain :: OStream Int -> Int -> <IO> ()
writeDrain o n = do
  ? n == 0 = do
      ()
  : do
    xs <- makeBatch n
    Ok u <- @write 0 o xs
    writeDrain o (n - 1)

--' Write n batches to a stream file; return the large-allocation count
runWrite :: Str -> Int -> <IO> Int
runWrite path n = do
  Ok o <- @open path :: <IO> (Try Str (OStream Int))
  writeDrain o n
  @close o
  bigAllocs n

parts :: <IO> (Try Str [Int]) -> <IO> (Bool, Str, [Int])
parts pull = do
  r <- pull
  match r
    | (Err e) = (False, e, [])
    | (Ok xs) = (True, "", xs)

partsDrain :: [Int] -> Int -> <IO> ()
partsDrain extra n = do
  ? n == 0 = do
      ()
  : do
    p <- parts (@try (makeBatch n))
    recordBatch extra (.2 p)
    partsDrain extra (n - 1)

--' Drain n batches through a Try-to-tuple match; return the large-allocation count
runParts :: Int -> Int -> <IO> Int
runParts k n = do
  partsDrain (makeExtra k) n
  bigAllocs n

singleDrain :: [Int] -> Int -> <IO> ()
singleDrain extra n = do
  ? n == 0 = do
      ()
  : do
    xs <- makeBatch n
    recordBatches extra [xs]
    singleDrain extra (n - 1)

--' Count allocations of batches passed in one-element lists
runSingle :: Int -> Int -> <IO> Int
runSingle k n = do
  singleDrain (makeExtra k) n
  bigAllocs n
