module main (shouldFail)

type Py => Str = "str"
type Py => Int = "int"

type Bytes = Str
type Py => Bytes = "bytes"

class Encode a where
  encode :: a -> Bytes

instance Encode Str where
  source Py from "test.py" ("encode_str" as encode)

-- Rejected at the declaration `type Py => Bytes = "bytes"`: a transparent
-- alias has no per-language form of its own (ALIAS-6); a type with its own
-- native form is a newtype.
shouldFail :: Str -> Bytes
shouldFail x = encode x
