-- A C++ producer captures a NON-SCALAR runtime value (a list, which may be
-- shared-memory-backed) and the closure crosses to an R higher-order function.
-- The reify path must copy the captured aggregate into a self-contained wire
-- packet whose SHM stays valid until the closure is applied back in C++. The
-- scalar cr-capture cannot exercise this (an int serializes inline).

module main (crossApply)

import root-cpp
import root-r

source Cpp from "producer.hpp" ("tick", "add", "vsum")
source R from "consumer.R" ("applyIt")

type Cpp => Int = "int"

tick :: <IO> Int
add :: Int -> Int -> Int
vsum :: [Int] -> Int
applyIt :: (Int -> Int) -> Int -> Int

mkSummer :: [Int] -> <IO> (Int -> Int)
mkSummer xs = do
  _ <- tick
  (\y -> add (vsum xs) y)

crossApply :: [Int] -> <IO> Int
crossApply xs = do
  f <- mkSummer xs
  applyIt f 10
