module main

  ( showInt
  , showReal
  , showBool
  , showStr
  , showList
  , showTuple
  , showRecord
  , showNested
  , showOptSome
  , showOptNone
  , showEmptyList
  , readInt
  , readReal
  , readBool
  , readStr
  , readList
  , readTuple
  , readRecord
  , readInvalid
  , readTypeMismatch
  , readEmptyStr
  , roundTripInt
  , roundTripReal
  , roundTripBool
  , roundTripStr
  , roundTripList
  , roundTripTuple
  , roundTripRecord
  , roundTripNested
  , showShowInt
  )

-- `Try` is declared in `internal` and reaches user code through `root`;
-- a fallible intrinsic or `@try` needs it in scope.
import root

-- No language-specific imports: all nexus-level evaluation
--
-- @read moved to `a` in the effect-migration; parse failure
-- raises Err instead of returning None. Every @read caller either
-- @catches (with a sentinel) or declares in its signature.

effect Err

record Point where
  x :: Int
  y :: Int

-- === @show tests ===

showInt :: Str
showInt = @show 42

showReal :: Str
showReal = @show 3.14

showBool :: Str
showBool = @show True

showStr :: Str
showStr = @show "hello"

showList :: Str
showList = @show [1, 2, 3]

showTuple :: Str
showTuple = @show (10, "abc")

showRecord :: Str
showRecord = @show {x = 1, y = 2}

showNested :: Str
showNested = @show [[1, 2], [3, 4]]

-- @read is now `a`; wrap in @catch to recover a value to @show.
showOptSome :: Str
showOptSome = @show (match (@read "42") | (Ok _cv) = _cv | (Err _) = -1)

showOptNone :: Str
showOptNone = @show (match (@read "bad") | (Ok _cv) = _cv | (Err _) = -1)

showEmptyList :: Str
showEmptyList = @show ([] :: [Int])

-- === @read tests -- each returns bare `a`; sentinel on Err ===

readInt :: Int
readInt = match (@read "42") | (Ok _cv) = _cv | (Err _) = -1

readReal :: Real
readReal = match (@read "3.14") | (Ok _cv) = _cv | (Err _) = -1.0

readBool :: Bool
readBool = match (@read "true") | (Ok _cv) = _cv | (Err _) = False

readStr :: Str
readStr = match (@read "\"hello\"") | (Ok _cv) = _cv | (Err _) = "err"

readList :: [Int]
readList = match (@read "[1,2,3]") | (Ok _cv) = _cv | (Err _) = []

readTuple :: (Int, Str)
readTuple = match (@read "[10,\"abc\"]") | (Ok _cv) = _cv | (Err _) = (0, "err")

readRecord :: Point
readRecord = match (@read "{\"x\":1,\"y\":2}") | (Ok _cv) = _cv | (Err _) = {x = 0, y = 0}

readInvalid :: Int
readInvalid = match (@read "not_a_number") | (Ok _cv) = _cv | (Err _) = -1

readTypeMismatch :: Int
readTypeMismatch = match (@read "\"hello\"") | (Ok _cv) = _cv | (Err _) = -1

readEmptyStr :: Int
readEmptyStr = match (@read "") | (Ok _cv) = _cv | (Err _) = -1

-- === round-trip tests: same shape via @catch ===

roundTripInt :: Int
roundTripInt = match (@read (@show 42)) | (Ok _cv) = _cv | (Err _) = -1

roundTripReal :: Real
roundTripReal = match (@read (@show 3.14)) | (Ok _cv) = _cv | (Err _) = -1.0

roundTripBool :: Bool
roundTripBool = match (@read (@show True)) | (Ok _cv) = _cv | (Err _) = False

roundTripStr :: Str
roundTripStr = match (@read (@show "hello")) | (Ok _cv) = _cv | (Err _) = "err"

roundTripList :: [Int]
roundTripList = match (@read (@show [1, 2, 3])) | (Ok _cv) = _cv | (Err _) = []

roundTripTuple :: (Int, Str)
roundTripTuple = match (@read (@show (10, "abc"))) | (Ok _cv) = _cv | (Err _) = (0, "err")

roundTripRecord :: Point
roundTripRecord = match (@read (@show {x = 1, y = 2})) | (Ok _cv) = _cv | (Err _) = {x = 0, y = 0}

roundTripNested :: [[Int]]
roundTripNested = match (@read (@show [[1, 2], [3, 4]])) | (Ok _cv) = _cv | (Err _) = []

-- === edge case: @show of @show ===

showShowInt :: Str
showShowInt = @show (@show 42)
