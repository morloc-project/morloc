module main (sr, spy, scpp, escR, escPy, escCpp, trpR, trpPy, trpCpp, braces, braceStr, afterEsc, sliced)

import root
import root-r
import root-py
import root-cpp

sr :: Str -> Str -> Str
sr x y = "x=#{idr x};y=#{idr y};"

spy :: Str -> Str -> Str
spy x y = "x=#{idpy x};y=#{idpy y};"

scpp :: Str -> Str -> Str
scpp x y = "x=#{idcpp x};y=#{idcpp y};"

-- test escape sequences inside interpolated strings
escR :: Str -> Str
escR x = "a\t\"#{idr x}\nb"

escPy :: Str -> Str
escPy x = "a\t\"\"\"#{idpy x}\nb"

escCpp :: Str -> Str
escCpp x = "a\t\"#{idcpp x}\nb"

-- triple-quoted strings must support #{...} interpolation just like
-- single-quoted ones (regression for C17). The result must match the
-- corresponding sr/spy/scpp output exactly.
trpR :: Str -> Str -> Str
trpR x y = """x=#{idr x};y=#{idr y};"""

trpPy :: Str -> Str -> Str
trpPy x y = """x=#{idpy x};y=#{idpy y};"""

trpCpp :: Str -> Str -> Str
trpCpp x y = """x=#{idcpp x};y=#{idcpp y};"""

-- A hole closes at its own brace, not at one inside a record or a string
record Pt where
  a :: Int
record Py => Pt = "dict"

braces :: Str -> Str
braces x = "#{x}#{show (.a ({a = 1} :: Pt))}"

braceStr :: Str -> Str
braceStr x = "#{x}#{"}"}"

-- A token after a string with an escape is placed after the string
afterEsc :: U64
afterEsc = size "\n"-1

-- A slice keeps its bracket context inside a hole
sliced :: [Int] -> Str
sliced xs = "#{show (.[::-1] xs)} #{show (.[1:-1] xs)}"
