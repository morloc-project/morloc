-- A parameterized recursive record is not yet generated in C++ (GEN-9 is
-- not implemented): the build is refused with a message naming the record,
-- and does not loop or crash. When GEN-9 lands this program should build.
module main (foo)

import root-cpp

record Container a where
  val :: a
  sub :: ?(Container a)

foo :: Int -> Container Int
foo n ? n > 0 = {val = n, sub = foo (n - 1)}
      : {val = 0, sub = Null}
