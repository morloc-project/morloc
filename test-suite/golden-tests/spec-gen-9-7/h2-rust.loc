-- GEN-9: a user-mapped Rust record with no parameters holding a packed field
-- crosses as a tuple of its unpacked fields; its form holds the native ones.
module main (h2)
import root-rust

newtype Date = Str
type Rust => Date = "DateT"

instance Packable Str Date where
  source Rust from "h2.rs" ("packDate" as pack, "unpackDate" as unpack)

record H2 where
  d :: Date
record Rust => H2 = "H2T"

source Rust from "h2.rs" ("same")
same :: a -> a

h2 :: H2 -> H2
h2 x = same x
