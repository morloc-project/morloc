--' A field whose type is an alias is the definition's field (GEN-9)
--'
--' A record literal of a record with fields of alias type (scalar, string,
--' parameterized, record) builds and crosses into a sourced function.
module main (sumCode, sameCode)

import root-rust

type Sym = Int
type Name = Str
type Box a = [a]

record Pt where
  x :: Int
  y :: Int

type P = Pt

record Code where
  sym :: Sym
  name :: Name
  items :: Box Int
  pt :: P

source Rust from "code.rs" ("code_len" as codeLen, "mk_code" as mkCode)

codeLen :: Code -> Int
mkCode :: Int -> Code

sumCode :: Int -> Int
sumCode n = codeLen {sym = n, name = "ab", items = [n, n], pt = {x = 1, y = 2}}

sameCode :: Int -> Bool
sameCode n = mkCode n == {sym = n, name = "ab", items = [n, n], pt = {x = 1, y = 2}}
