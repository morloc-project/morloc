-- Optional widening UNDER a suspension.
--
-- A do-block is a suspension <E> T. When such a block is checked against a
-- declared <E> ?T return, the value it yields is widened to ?T inside the
-- suspension (the coercion acts on the result of the run, never on the
-- thunk), and the export boundary serializes the optional wire form.
--
-- `mkOpt` is a suspension of Int that may throw; `@try` over it is a
-- suspension of a Try; the match widens its Int arm against the Null arm.

module main
  ( presentSmall
  , presentBig
  )

import root
import root-py

mkOpt :: Int -> <> Int
mkOpt x = do
    let bound = x
    ? x < 4 = @throw "value must be >= 4"
    : bound

presentSmall :: <> ?Int
presentSmall = do
  r <- @try (mkOpt 5)
  match r | (Ok v) = v | (Err _) = Null

presentBig :: <> ?Int
presentBig = do
  r <- @try (mkOpt 42)
  match r | (Ok v) = v | (Err _) = Null
