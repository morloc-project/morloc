-- Suspension conformance: home=rust away=r.
-- The computation (tickH, one byte appended to a counter file) lives in the
-- home pool; every cell forces it three times from the away side and prints
-- the count. Generated by gen.py; do not edit by hand.
module main (rootResult, rootArg, recordField, listElem, callback, pinned, relay)

import root-r
import root-rust

record Holder where
  run :: <IO> Int

record Caller where
  inc :: Int -> <IO> Int

record R => Holder = "list"
record R => Caller = "list"
record Rust => Holder = "Holder"
record Rust => Caller = "Caller"

source Rust from "host.rs"
  ( "tick" as tickH
  , "mark" as markH
  , "ident" as identH
  , "take_thunk" as takeThunkH
  )
source R from "host.R"
  ( "ident" as identA
  , "take_thunk" as takeThunkA
  , "use_record" as useRecordA
  , "use_list" as useListA
  , "use_callback" as useCallbackA
  , "use_pinned" as usePinnedA
  )

tickH :: Str -> <IO> Int
markH :: Str -> Str
identH :: Int -> Int
takeThunkH :: <IO> Int -> <IO> Int
identA :: Int -> Int
takeThunkA :: <IO> Int -> <IO> Int
useRecordA :: Holder -> <IO> Int
useListA :: [<IO> Int] -> <IO> Int
useCallbackA :: (Int -> <IO> Int) -> Int -> <IO> Int
usePinnedA :: Caller -> Int -> <IO> Int

-- the computation under test: morloc-defined, its body in the home pool
homeEff :: Str -> Int -> <IO> Int
homeEff p x = do
  n <- tickH p
  identH n

rootResult :: Str -> <IO> Int
rootResult p = do
  let t = homeEff p 0
  _ <- t
  _ <- t
  c <- t
  identA c

rootArg :: Str -> <IO> Int
rootArg p = takeThunkA (homeEff p 0)

recordField :: Str -> <IO> Int
recordField p = useRecordA { run = homeEff p 0 }

listElem :: Str -> <IO> Int
listElem p = useListA [homeEff p 0]

callback :: Str -> <IO> Int
callback p = useCallbackA (\x -> homeEff p x) 0

pinned :: Str -> <IO> Int
pinned p = usePinnedA { inc = \x -> homeEff p x } 0

-- the thunk goes home -> away pool code -> home host
awayPass :: <IO> Int -> <IO> Int
awayPass t = do
  let _z = identA 1
  t

relay :: Str -> <IO> Int
relay p = takeThunkH (awayPass (homeEff p 0))
