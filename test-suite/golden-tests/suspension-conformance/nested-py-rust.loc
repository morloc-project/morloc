-- Suspension conformance: home=py away=rust.
-- The computation (tickH, one byte appended to a counter file) lives in the
-- home pool; every cell forces it three times from the away side and prints
-- the count. Generated by gen.py; do not edit by hand.
module main (closureResult, nestedSusp)

import root-py
import root-rust

record Holder where
  run :: <IO> Int

record Caller where
  inc :: Int -> <IO> Int

record Py => Holder = "dict"
record Py => Caller = "dict"
record Rust => Holder = "Holder"
record Rust => Caller = "Caller"

source Py from "host.py"
  ( "tick" as tickH
  , "mark" as markH
  , "ident" as identH
  , "take_thunk" as takeThunkH
  )
source Rust from "host.rs"
  ( "ident" as identA
  , "take_thunk" as takeThunkA
  , "use_record" as useRecordA
  , "use_list" as useListA
  , "use_callback" as useCallbackA
  , "use_pinned" as usePinnedA
  )

tickH :: Str -> <IO> Int
markH :: Str -> Str
identH :: Int -> Int
takeThunkH :: <IO> Int -> <IO> Int
identA :: Int -> Int
takeThunkA :: <IO> Int -> <IO> Int
useRecordA :: Holder -> <IO> Int
useListA :: [<IO> Int] -> <IO> Int
useCallbackA :: (Int -> <IO> Int) -> Int -> <IO> Int
usePinnedA :: Caller -> Int -> <IO> Int

-- the computation under test: morloc-defined, its body in the home pool
homeEff :: Str -> Int -> <IO> Int
homeEff p x = do
  n <- tickH p
  identH n

-- a function value with a suspension result, built at home
mkF :: Str -> Int -> <IO> Int
mkF p = let q = markH p in \x -> homeEff q x

closureResult :: Str -> <IO> Int
closureResult p = do
  let f = mkF p
  _ <- f 1
  _ <- f 1
  c <- f 1
  identA c

-- the outer run ticks once and yields the inner thunk
prepare :: Str -> <IO> (<IO> Int)
prepare p = do
  _ <- tickH p
  homeEff p 0

nestedSusp :: Str -> <IO> Int
nestedSusp p = do
  stmt <- prepare p
  _ <- stmt
  _ <- stmt
  c <- stmt
  identA c
