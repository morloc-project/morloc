module main (curriedDef, flatDef, stagedDef, threeGroups)

import root-r

-- The source calls the function it is passed with every argument at once
-- (HOST-2): its parameter is written `(Int -> (Int -> Int))`, which is the
-- type `Int -> Int -> Int`. However a morloc function of that type is
-- defined -- returning a lambda, with two parameters, or doing work before
-- the lambda it returns -- it is handed over taking both.

source R from "helpers.R" ("make_and_apply" as makeAndApply, "make_and_apply3" as makeAndApply3)
makeAndApply :: (Int -> (Int -> Int)) -> Int -> Int
makeAndApply3 :: (Int -> (Int -> (Int -> Int))) -> Int -> Int

mulC :: Int -> (Int -> Int)
mulC base = \y -> base * y

mulF :: Int -> Int -> Int
mulF a b = a * b

-- the work before the lambda runs in each call, given both arguments
scaled :: Int -> Int -> Int
scaled base = let z = base * 10 in \y -> z + y

curriedDef :: Int -> Int
curriedDef x = makeAndApply mulC x

flatDef :: Int -> Int
flatDef x = makeAndApply mulF x

stagedDef :: Int -> Int
stagedDef x = makeAndApply scaled x

-- three arguments in one call
mul3 :: Int -> Int -> Int -> Int
mul3 a b c = a * b * c

threeGroups :: Int -> Int
threeGroups x = makeAndApply3 mul3 x
