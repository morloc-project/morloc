-- A panic in a function a sourced Rust file pulls in from outside its own
-- directory is still the user's (model/panic.md PANIC-15): the generated
-- source calls it on a line of its own, and that line is the user's. @try
-- catches it and the pool keeps serving.
module main (tryHelper, helperOk)

import root
import root-rust

type Rust => Int = "i64"

source Rust from "src/h.rs" ("helper_panics" as helperPanics)

helperPanics :: Int -> Int

tryHelper :: Int -> Int
tryHelper x = match (@try (helperPanics x)) | (Ok v) = v | (Err _) = -2

helperOk :: Int -> Int
helperOk x = helperPanics x
