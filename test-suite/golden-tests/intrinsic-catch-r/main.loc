-- Test @catch in an R-bound pool: same coverage as the Py/Cpp variants --
-- pure catch of @throw, catch inside a do-block, mixed <IO> catch,
-- and catch of a foreign R exception (stop() from a sourced function).
module main (catchBare, catchInDo, catchMixedIO, catchForeignRaise, catchBangFallible)

import root
import root-r

source R from "helper.R" ("r_len", "r_may_fail")

r_len      :: Str -> Int
r_may_fail :: Str -> Int

catchBare :: Int
catchBare = match (@try (@throw "boom")) | (Ok _cv) = _cv | (Err _) = 42

catchInDo :: Str -> <IO> Int
catchInDo s = match (@try (do
    let n = r_len s
    ? n < 4 = @throw "too short"
    : n
  )) | (Ok _cv) = _cv | (Err _) = 999

catchMixedIO :: Str -> <IO> Int
catchMixedIO s = match (@try (do
    let n = r_len s
    ? n == 0 = @throw "empty"
    : n
  )) | (Ok _cv) = _cv | (Err _) = (r_len "fallback")

catchForeignRaise :: Str -> <IO> Int
catchForeignRaise s = match (@try (do
    let n = r_may_fail s
    n
  )) | (Ok _cv) = _cv | (Err _) = 0

-- ! inside @catch's fallible seals at the arg site (Restructure.hs
-- IntrCatch special-case). Empty string raises inside the try/catch.
catchBangFallible :: Str -> Int
catchBangFallible s = match (@try (r_may_fail s)) | (Ok _cv) = _cv | (Err _) = 77
