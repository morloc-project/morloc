module main (test_a, test_b)

import ops-a ((&~))
import ops-b ((&))

type Py => Int = "int"

-- ops-a's (&~) is infixl 5 and adds 10: left-associative
-- 2 &~ 3 &~ 4 = (2 &~ 3) &~ 4 = 15 &~ 4 = 29
test_a :: Int
test_a = 2 &~ 3 &~ 4

-- ops-b's (&) is infixr 7 and adds 100: right-associative
-- 2 & 3 & 4 = 2 & (3 & 4) = 2 & 107 = 209
test_b :: Int
test_b = 2 & 3 & 4
