-- Effectful functions in a record built in one pool and handed to a host in
-- another: the record crosses as data and the host's pool adapts it.
-- Report: /work/plans/host-adapter-by-type.md
-- Generated by gen.py; do not edit by hand.
module main (pyToRust, rustToPy)

import root-py
import root-rust

record Ops where
  get :: Int -> <IO> Int

record Py => Ops = "dict"
record Rust => Ops = "Ops"

source Py from "host.py" ("tick" as tickPy, "h_ops" as hOpsPy)
source Rust from "host.rs" ("tick" as tickRs, "h_ops" as hOpsRs)

tickPy :: Str -> <IO> Int
hOpsPy :: Ops -> Int -> <IO> Str
tickRs :: Str -> <IO> Int
hOpsRs :: Ops -> Int -> <IO> Str

effPy :: Str -> Int -> <IO> Int
effPy p i = do
  n <- tickPy p
  n * 100 + i

effRs :: Str -> Int -> <IO> Int
effRs p i = do
  n <- tickRs p
  n * 100 + i

opsPy :: Str -> Ops
opsPy p = { get = \i -> effPy p i }

opsRs :: Str -> Ops
opsRs p = { get = \i -> effRs p i }

pyToRust :: Str -> <IO> Str
pyToRust p = hOpsRs (opsPy p) 5

rustToPy :: Str -> <IO> Str
rustToPy p = hOpsPy (opsRs p) 5
