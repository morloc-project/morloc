-- Runtime closures nested in a record / list / tuple / optional crossing a pool
-- boundary. Producer: Rust (reify). Consumer: Python (reflect). Exercises the
-- Rust member's closure REIFICATION for every aggregate shape: the closures are
-- boxed into `Rc<dyn MorlocFnN>` inside the Rust aggregate, reified in place into
-- the wire tuple, and reflected as Python callables that RPC back to the Rust
-- home pool on application.
--
-- The captured `a`/`b` are runtime CLI arguments, so they are NOT constant
-- folded: the Rust producer must serialize genuinely captured values into each
-- closure's wire form (via reify_capture). A literal capture would fold empty.

module main (crossRecord, crossList, crossTuple, crossOpt)

import root-rust
import root-py

record Ops where
  inc :: Int -> Int
  scale :: Int -> Int
record Rust => Ops = "Ops"

type Rust => Int = "i64"

source Rust from "producer.rs" ("tick", "add", "mul")
source Py from "consumer.py"
  ( "use_ops" as useOps
  , "use_list" as useList
  , "use_tuple" as useTuple
  , "use_opt" as useOpt
  )

tick :: <IO> Int
add :: Int -> Int -> Int
mul :: Int -> Int -> Int

useOps :: Ops -> Int -> Int
useList :: [Int -> Int] -> Int -> Int
useTuple :: (Int -> Int, Int -> Int) -> Int -> Int
useOpt :: ?(Int -> Int) -> Int -> Int

mkOps :: Int -> Int -> <IO> Ops
mkOps a b = do
  _ <- tick
  { inc = (\x -> add a x), scale = (\x -> mul b x) }

crossRecord :: Int -> Int -> <IO> Int
crossRecord a b = do
  ops <- mkOps a b
  useOps ops 10

crossList :: Int -> Int -> <IO> Int
crossList a b = do
  _ <- tick
  useList [(\x -> add a x), (\x -> mul b x)] 10

crossTuple :: Int -> Int -> <IO> Int
crossTuple a b = do
  _ <- tick
  useTuple ((\x -> add a x), (\x -> mul b x)) 10

crossOpt :: Int -> <IO> Int
crossOpt a = do
  _ <- tick
  useOpt (\x -> add a x) 10
