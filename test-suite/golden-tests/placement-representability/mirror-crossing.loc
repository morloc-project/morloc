-- The mirror case when the closure holding the Python-only record crosses
-- back into Python (a C++ closure passed to a Python function), and when the
-- closure is Rust's. Each carries the record as the packet it received.
module mirrorCrossing (crossed, rustCaptured)

import root-cpp
import root-rust

record PyOpts where
  m :: Int
record Py => PyOpts = "dict"
type Py => Int = "int"
source Py from "pyhof.py" ("py_m" as pyM, "py_mk" as pyMk, "py_apply" as pyApply)
pyM :: PyOpts -> Int
pyMk :: Int -> PyOpts
pyApply :: (Int -> Int) -> Int -> Int

source Cpp from "opts.hpp" ("cpp_inc" as cppInc)
cppInc :: Int -> Int

source Rust from "helpers.rs" ("rs_apply" as rsApply, "rs_inc" as rsInc)
rsApply :: (Int -> Int) -> Int -> Int
rsInc :: Int -> Int

crossed :: Int -> Int
crossed k = let o = pyMk k in pyApply (\r -> cppInc r + pyM o) k

rustCaptured :: Int -> Int
rustCaptured k = let o = pyMk k in rsApply (\r -> rsInc r + pyM o) k
