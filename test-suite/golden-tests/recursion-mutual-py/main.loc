module main (isEven, isOdd, viaF)

import root-py

isEven :: Int -> Bool
isEven n
  ? n == 0 = True
  : isOdd (n - 1)

isOdd :: Int -> Bool
isOdd n
  ? n == 0 = False
  : isEven (n - 1)

-- a pair entered through a term that is not exported, one of them also
-- recursing on itself
f :: Int -> Int
f n
  ? n <= 0 = 1
  : g (n - 1)

g :: Int -> Int
g n
  ? n <= 0 = 0
  : (? n > 5 = g (n - 1) : f (n - 1))

viaF :: Int -> Int
viaF n = f n
