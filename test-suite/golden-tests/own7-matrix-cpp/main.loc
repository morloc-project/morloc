c484f j x = ? j > 1 = c484f (j - 2) x : ? j > 0 = [x] : []
c484f2 :: Int -> [Pay] -> [Pay] -> [[Pay]]
c484f2 j a b = ? j > 0 = [a] : [b]
c484 :: Int -> Int -> (Int, Int)
c484 n j = census ((let x = [mkp n, mkp 1] in (\r -> sum (map (\v -> sum (map keyp v)) r)) (c484f2 j x x)))

