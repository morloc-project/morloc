c042f j x = ? j > 0 = {w = x, tag = 1} : {w = mkp 0, tag = 0}
c042g :: Int -> Pay -> Int
c042g j x = (\r -> (keyp (.w r)) + .tag r) (c042f j x)
c042 :: Int -> Int -> (Int, Int)
c042 n j = census (c042g j (mkp n))

-- c043: P kept by ctor under if, caller loop, j=1
c043f :: Int -> Pay -> WP
c043f j x = ? j > 0 = {w = x, tag = 1} : {w = mkp 0, tag = 0}
c043lp :: Int -> Int -> Pay -> Int -> Int
c043lp j k x acc
  ? k == 0 = acc + (\x -> keyp x) x
  : c043lp j (k - 1) x (acc + (\r -> (keyp (.w r)) + .tag r) (c043f j x))
c043 :: Int -> Int -> (Int, Int)
c043 n j = census (c043lp j 3 (mkp n) 0)

