module main (testShow, testRead, testRoundTrip)

import root-cpp
import root-py

source Cpp from "foo.hpp" ("identity_int" as identityInt)

identityInt :: Int -> Int

-- @show in C++ pool context
showCpp :: Int -> Str
showCpp x = @show (identityInt x)

-- @show in nexus (no pool context)
showNexus :: Int -> Str
showNexus x = @show x

-- round-trip: show then read should recover the original value.
-- @read raises Err on parse failure; caller can @catch or declare .
roundTrip :: Int -> Int
roundTrip x  = unwrap (@read (@show x))

testShow :: Bool
testShow = showCpp 42 == "42" && showNexus 42 == "42"

testRead :: Int
testRead = match (@read "42" :: Try Str (Int)) | (Ok _cv) = _cv | (Err _) = -1

testRoundTrip :: Int
testRoundTrip = match (@try (roundTrip 99)) | (Ok _cv) = _cv | (Err _) = -1
