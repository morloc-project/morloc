module main (s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, i1, i2, i3, i4, i5, i6, e1, e2, w1)

import root-py

s1 =
  """
    This is the start of a grand paragraph. That
  has many lines that have few initial spaces than
  the first paragraph.
  """

s2 = """you can also use "multiline" strings in one line with internal quotes"""

s3 = '''single quotes are also OK'''

-- empty string
s4 =
  """
  """

-- quote right before closing: """bar - "foo"""" has content bar - "foo"
s5 = """bar - "foo""""

-- seven quotes total: """ + " + """ -> content is "
s6 = """""""

-- single-quote variant: content is bar - 'foo'
s7 = '''bar - 'foo''''

-- seven single quotes: ''' + ' + ''' -> content is '
s8 = '''''''

-- single-line triple-quoted is identical to single-quoted: no reindent,
-- no blank-line stripping, leading/trailing whitespace preserved
s9 = """   hello   """

-- mixed-quote variant of s9
s10 = '''   hello   '''

-- An interpolated string is dedented as a whole; each hole is content
i1 :: Str -> Str
i1 x = """
    hi #{x}
      there
    """

i2 :: Str -> Str
i2 x = """
    #{x} first
    """

i3 :: Str -> Str
i3 x = """
    a #{
  x}
    b
    """

i4 :: Str -> Str
i4 x = """
      #{x}
    tail #{x}
    """

i5 :: Str -> Str
i5 x = '''
    q #{x}
    '''

i6 :: Str -> Str
i6 x = """
    a #{x}\tb\n    c
    """

-- Escapes are decoded after dedenting: an escaped newline does not start a
-- source line
e1 :: Str
e1 = """
  a\n  b
  """

e2 :: Str
e2 = """
  \n  x
  """

-- A hole's lines do not take part in the layout around the string
w1 :: Str -> Str
w1 x = y
  where
    y = """
      a #{
x}
      """
