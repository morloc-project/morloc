--' Choose between Python adders and use the one chosen in C++
module main (chosenAway)

import root-py
import root-cpp
import .helpers

source Py from "f.py" ("py_make_adder" as mkPy)
source Cpp from "f.hpp" ("cpp_make_adder" as mkCpp)

--' Make an adder in Python
mkPy :: Int -> <IO> (Int -> Int)
--' Make an adder in C++
mkCpp :: Int -> <IO> (Int -> Int)

--' Use a chosen Python adder in C++
chosenAway :: Bool -> Int -> <IO> Int
chosenAway b n = do
  h <- ? b = mkPy n : mkPy (n + 1)
  cppSum (cppMap (\x -> cppF (h x)) [1, 2])
