--' A forced Python suspension in a scope using a C++ adder
module main (suspendedTwo)

import root-py
import root-cpp
import .helpers

source Py from "f.py" ("py_make_adder" as mkPy)
source Cpp from "f.hpp" ("cpp_make_adder" as mkCpp)

--' Make an adder in Python
mkPy :: Int -> <IO> (Int -> Int)
--' Make an adder in C++
mkCpp :: Int -> <IO> (Int -> Int)

--' Use a C++ adder and a Python adder from a forced suspension
suspendedTwo :: Int -> <IO> Int
suspendedTwo n = do
  g <- mkCpp n
  let s = mkPy n
  h <- s
  pySum (pyMap (\x -> pyF (h x)) [1]) + cppSum (cppMap (\x -> cppF (g x)) [1])
