--' An adder made in Python or in C++ by branch
module main (byBranch)

import root-py
import root-cpp
import .helpers

source Py from "f.py" ("py_make_adder" as mkPy)
source Cpp from "f.hpp" ("cpp_make_adder" as mkCpp)

--' Make an adder in Python
mkPy :: Int -> <IO> (Int -> Int)
--' Make an adder in C++
mkCpp :: Int -> <IO> (Int -> Int)

--' Use an adder made by either branch in Python
byBranch :: Bool -> Int -> <IO> Int
byBranch b n = do
  h <- ? b = mkPy n : mkCpp n
  pySum (pyMap h [1, 2])
