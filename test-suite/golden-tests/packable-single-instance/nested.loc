--' A Packable whose wire form mentions another Packable. Lowering the outer
--' instance's unpacked type has to recurse into the inner instance rather than
--' emit the inner constructor's name as an opaque leaf.

module nested (howOuter)

import root-py

newtype Inner a
newtype Outer a

type Py => (Inner a) = "dict" a
type Py => (Outer a) = "dict" a

instance Packable [a] (Inner a) where
  source Py from "helpers.py" ("pack_generic" as pack, "unpack_generic" as unpack)

instance Packable [Inner a] (Outer a) where
  source Py from "helpers.py" ("pack_special" as pack, "unpack_special" as unpack)

source Py from "helpers.py" ("how" as how)

how :: Outer a -> Str

howOuter :: Outer Int -> Str
howOuter = how
