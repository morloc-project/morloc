-- Spec NEWT-7: in a Python-only program, Bytes (which has a Python form of
-- its own) is unwrapped by its explicit Python instance, not by the
-- representation cast.
module main (roundTrip)

import root-py

newtype Bytes = Str
type Py => Bytes = "bytes"

instance Packable Str Bytes where
  source Py from "main.py" ("to_bytes" as pack, "from_bytes" as unpack)

roundTrip :: Str -> Bool
roundTrip s = s == unpack (pack s :: Bytes)
