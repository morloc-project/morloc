-- Records built in a pool need a declaration for that pool's language.
-- Without one, morloc make fails, without looping on this parameterized
-- recursive record, and names the `record` declaration to add.
-- plain.loc is the unparameterized case.

module main (foo)

import root
import root-py

record Container a where
  val :: a
  sub :: ?(Container a)

foo :: Int -> Container Int
foo n ? n > 0 = {val = n, sub = foo (n - 1)}
      : {val = 0, sub = Null}
