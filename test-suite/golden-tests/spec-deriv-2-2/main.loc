-- Spec DERIV-2: derived Eq, Ord, Show and Hashable act on the wire value,
-- with the same results in every language.
module main (checks, texts)

import root-cpp

newtype Name = Str
  deriving (Eq, Ord, Show, Hashable)

data Shape = Circle Real | Rect Real Real | Dot
  deriving (Eq, Ord, Show)

checks :: [Bool]
checks =
  [ (idcpp ("ab" :: Name)) == ("ab" :: Name)
  , (idcpp ("ab" :: Name)) < ("b" :: Name)
  , (idcpp (Circle 1.0)) == Circle 1.0
  , (idcpp (Rect 1.0 2.0)) < Rect 1.0 1.0
  , (idcpp Dot) > Circle 5.0
  ]

texts :: [Str]
texts =
  [ show (idcpp ("ab" :: Name))
  , show (idcpp (Rect 1.0 2.0))
  , hash (idcpp ("ab" :: Name))
  ]
