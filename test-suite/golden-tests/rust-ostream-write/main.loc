-- Rust pool member: OStream write intrinsics, end to end.
--
-- Covers the stream-writer intrinsic family in a Rust pool:
--   * @open path :: OStream T  -- typed create + header
--   * @write level handle xs   -- emit one sub-packet
--   * @flush handle            -- force buffered elements out
--   * @close handle            -- final footer + close
--   * @append path :: OStream T -- resume an existing stream
--   * @concat [src..] dest      -- byte-level merge
--   * @flen handle              -- element count (via reopened IFile)
--
-- Each writer result is read back (as IStream via @next, or as IFile
-- via @flen) to prove the round-trip. All handle state lives in the
-- shared-SHM slot registry keyed by the u64 handle.
--
-- Rust because it imports root-rust; the spec is backend-agnostic.

module main
  ( testWriteOne
  , testWriteMulti
  , testWriteIStream
  , testAppendThenLength
  , testConcatTwo
  , testStreamLayoutChunks
  )

import root-rust

-- 1. Write one sub-packet; reopen as IStream and read it back.
testWriteOne :: Str -> <IO> [Int]
testWriteOne path = do
  Ok s <- @open path :: <IO> (Try Str (OStream Int))
  @write 0 s [10, 20, 30]
  @close s
  Ok r <- @open path :: <IO> (Try Str (IStream Int))
  Ok _tailv80 <- @next r
  _tailv80

-- 2. Write three sub-packets; reopen as IFile, check length.
testWriteMulti :: Str -> <IO> Int
testWriteMulti path = do
  Ok s <- @open path :: <IO> (Try Str (OStream Int))
  @write 0 s [1, 2, 3]
  @flush s
  @write 0 s [4, 5, 6, 7]
  @flush s
  @write 0 s [8]
  @close s
  Ok f <- @open path :: <IO> (Try Str (IFile Int))
  Ok _tailv81 <- @flen f
  _tailv81

-- 3. Write multi-sub-packet file, reopen as IStream, first @next.
testWriteIStream :: Str -> <IO> [Int]
testWriteIStream path = do
  Ok o <- @open path :: <IO> (Try Str (OStream Int))
  @write 0 o [100, 200]
  @flush o
  @write 0 o [300, 400, 500]
  @close o
  Ok s <- @open path :: <IO> (Try Str (IStream Int))
  Ok _tailv82 <- @next s
  _tailv82

-- 4. Append to a closed stream; total element count = 3 + 2.
testAppendThenLength :: Str -> <IO> Int
testAppendThenLength path = do
  Ok o <- @open path :: <IO> (Try Str (OStream Int))
  @write 0 o [1, 2, 3]
  @close o
  Ok o2 <- @append path :: <IO> (Try Str (OStream Int))
  @write 0 o2 [4, 5]
  @close o2
  Ok f <- @open path :: <IO> (Try Str (IFile Int))
  Ok _tailv83 <- @flen f
  _tailv83

-- 5. Concat two source files; total element count = 3 + 2.
testConcatTwo :: Str -> Str -> Str -> <IO> Int
testConcatTwo a b dest = do
  Ok oa <- @open a :: <IO> (Try Str (OStream Int))
  @write 0 oa [11, 22, 33]
  @close oa
  Ok ob <- @open b :: <IO> (Try Str (OStream Int))
  @write 0 ob [44, 55]
  @close ob
  @concat [a, b] dest
  Ok f <- @open dest :: <IO> (Try Str (IFile Int))
  Ok _tailv84 <- @flen f
  _tailv84

-- 6. @streamLayout on a 3-sub-packet IFile returns one (offset,count,size)
-- triple per sub-packet; its length is the chunk count. This materialises
-- the whole [(U64,U64,U64)] layout via the Rust FromVoidstar path (the
-- same value-out shape as @next), then counts the chunks.
testStreamLayoutChunks :: Str -> <IO> U64
testStreamLayoutChunks path = do
  Ok s <- @open path :: <IO> (Try Str (OStream Int))
  @write 0 s [1, 2, 3]
  @flush s
  @write 0 s [4, 5, 6, 7]
  @flush s
  @write 0 s [8]
  @close s
  Ok f <- @open path :: <IO> (Try Str (IFile [Int]))
  Ok layout <- @streamLayout f
  size layout
