-- A function that returns a function, defined in morloc, is passed to a
-- higher-order source whose parameter is written `(Int -> (Int -> Int))`: the
-- source calls it with one argument and applies the closure that returns.
-- roundtrip 4 -> 16.

module main (roundtrip)

import root-py

source Py from "helpers.py" ("mul", "applyIt", "makeAndApply")

mul :: Int -> Int -> Int
applyIt :: (Int -> Int) -> Int -> Int
makeAndApply :: (Int -> (Int -> Int)) -> Int -> Int

mkMul :: Int -> (Int -> Int)
mkMul base = \y -> mul base y

roundtrip :: Int -> Int
roundtrip x = makeAndApply mkMul x
