-- A packed list whose elements are packed is unpacked once, not once per
-- element read. `Outer` is unpacked into a list of `Inner`, each unpacked
-- in turn; the outer unpacker logs each call to calls.log.
module main (mk)

import root-cpp

newtype Inner = Int
type Cpp => Inner = "double"

instance Packable Int Inner where
  source Cpp from "p.hpp" ("packInner" as pack, "unpackInner" as unpack)

newtype Outer = [Inner]
type Cpp => Outer = "outer_t"

instance Packable [Inner] Outer where
  source Cpp from "p.hpp" ("packOuter" as pack, "unpackOuter" as unpack)

source Cpp from "p.hpp" ("mk")

--' Make an Outer of n elements
mk :: Int -> Outer
