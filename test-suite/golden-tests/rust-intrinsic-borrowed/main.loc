-- A value-in intrinsic (@show) applied to a BORROWED non-Copy Rust value.
-- `show(&(&Vec))` does not compile (`ToVoidstar` is not implemented for
-- `&Vec<i64>`), and a clone would copy the whole value only to read it; the
-- sink reborrows it instead, `show(&(*x))`.
--
-- `showEach` maps over a list of lists, so each inner list reaches `@show` as
-- a borrowed element; `lensEach` sends each one to Python, serializing it the
-- same way. `demo` calls `showList` twice; whether it arrives
-- borrowed depends on whether the realizer inlines it.

module main (demo, showEach, lensEach)

import root-rust
import root-py

source Py from "helpers.py" ("py_len" as pyLen)
pyLen :: [Int] -> Int

source Rust from "helpers.rs" ("cat_str" as catStr, "rs_map" as rsMap)
catStr :: Str -> Str -> Str
rsMap :: (a -> b) -> [a] -> [b]

showList :: [Int] -> Str
showList xs = @show xs

demo :: [Int] -> [Int] -> Str
demo xs ys = catStr (showList xs) (showList ys)

showEach :: [[Int]] -> [Str]
showEach xss = map (\xs -> @show xs) xss


lensEach :: [[Int]] -> [Int]
lensEach xss = rsMap (\xs -> pyLen xs) xss
