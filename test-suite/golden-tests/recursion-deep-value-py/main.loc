-- A recursive `data` value of depth 100000 crosses a manifold boundary
-- (put_value / get_value) in the py pool. Both morloc functions are
-- tail-recursive and run as native loops; what this pins is that the pool's
-- (de)serializer walks the value without one machine-stack frame per level,
-- so the depth is bounded by memory rather than by the worker thread's stack.
-- The depth is kept under the pool's recursive destructor limit (C++
-- shared_ptr and Rust Box chains still unwind recursively).
module main (chainCount)

import root-py

data Tree = Leaf | Node Int Tree Tree

chainHelp :: Int -> Tree -> Tree
chainHelp n acc
  ? n == 0 = acc
  : chainHelp (n - 1) (Node 1 Leaf acc)

spineCount :: Int -> Tree -> Int
spineCount | acc (Node _ _ r) = spineCount (acc + 1) r
           | acc _ = acc

chainCount :: Int -> Int
chainCount n = spineCount 0 (chainHelp n Leaf)
