-- Rust pool member: content-hash and disk-persistence intrinsics.
--
-- Covers the value-marshalling intrinsic family in a Rust pool:
--   * @hash  a -> Str          -- structural content hash (hex)
--   * @save  level a path      -- write voidstar packet to disk
--   * @savej path a            -- write JSON to disk (path-first sink)
--   * @load  path :: T         -- read a saved packet back as T
--
-- @hash is computed in libmorloc over the voidstar, so it is stable
-- and identical across pool languages. @save/@load round-trip both an
-- autogenerated record (exercising the Rust To/FromVoidstar impls the
-- translator emits for a record only ever touched by an IO intrinsic)
-- and a plain list.
--
-- The suite is Rust because it imports root-rust; swapping that import
-- for root-cpp / root-py / root-r runs the identical spec in another
-- backend.

module main
  ( hashScalar
  , hashRecord
  , saveLoadRecord
  , saveLoadList
  , saveJsonLoad
  )

import root-rust

record Point where
  x :: Int
  y :: Int
record Rust => Point = "struct"

mkPoint :: Int -> Int -> Point
mkPoint a b = {x = a, y = b}

-- Structural hash of a scalar.
hashScalar :: Int -> Str
hashScalar x = @hash x

-- Structural hash of a record.
hashRecord :: Int -> Int -> Str
hashRecord a b = @hash (mkPoint a b)

-- Round-trip an autogenerated record through the voidstar packet format.
saveLoadRecord :: Str -> <IO, Err> Point
saveLoadRecord path = do
  @save 0 path (mkPoint 3 4)
  @load path :: <IO, Err> Point

-- Round-trip a list.
saveLoadList :: Str -> <IO, Err> [Int]
saveLoadList path = do
  @save 0 path [10, 20, 30]
  @load path :: <IO, Err> [Int]

-- Save as JSON (path-first sink), then load back.
saveJsonLoad :: Str -> <IO, Err> Point
saveJsonLoad path = do
  @savej path (mkPoint 7 8)
  @load path :: <IO, Err> Point
