--' Ordinary English in a docstring is prose, not a directive.
--'
--\ A line whose first word ends in a colon is prose, and so is an unknown
--\ `@word`; both reach the help as the author wrote them. An unknown
--\ `@word` is also reported, since `@` begins a directive.
module main (f, g)

import root

alt :: [Int] -> Str
alt _ = "alt"

--' Do a thing
--' Note: this is a fast path.
--' @append reopens the file
--' See http://example.com for details
--' @render -a/--alt=alt
f :: [Int]
f = [1,2,3]

--' A real directive still takes effect
--' @name renamed
g :: Int -> Int
g x = x
