-- Rust pool member: stdio stream intrinsics (the Unix-filter shape).
--
-- Covers @stdin / @stdout in a Rust pool, driven over the nexus RPC
-- socket rather than a file:
--   * @stdout :: OStream T  -- forward-only writer to process stdout
--   * @stdin  :: IStream T  -- forward-only reader from process stdin
--   * @write / @flush / @close / @next as in the file streams
--
-- `producer` writes a fixed sequence to @stdout and closes.
-- `doubler` reads three sub-packets from @stdin, doubles each element,
-- writes each to @stdout, closes. `checkSum` reads three sub-packets
-- and returns the total.
--
-- producer | doubler | checkSum = (1+..+10) * 2 = 110.
--
-- Rust because it imports root-rust; the spec is backend-agnostic.

module main (producer, doubler, checkSum)

import root-rust

sumList :: [Int] -> Int
sumList xs = fold (+) 0 xs

doubleList :: [Int] -> [Int]
doubleList xs = map (\x -> x * 2) xs

producer :: <IO, Err> ()
producer = do
  o <- @stdout :: <IO, Err> OStream Int
  @write 0 o [1, 2, 3]
  @flush o
  @write 0 o [4, 5, 6]
  @flush o
  @write 0 o [7, 8, 9, 10]
  @close o

doubler :: <IO, Err> ()
doubler = do
  s <- @stdin  :: <IO, Err> IStream Int
  o <- @stdout :: <IO, Err> OStream Int
  xs1 <- @next s
  @write 0 o (doubleList xs1)
  @flush o
  xs2 <- @next s
  @write 0 o (doubleList xs2)
  @flush o
  xs3 <- @next s
  @write 0 o (doubleList xs3)
  @close o

checkSum :: <IO, Err> Int
checkSum = do
  s <- @stdin :: <IO, Err> IStream Int
  xs1 <- @next s
  xs2 <- @next s
  xs3 <- @next s
  sumList xs1 + sumList xs2 + sumList xs3
