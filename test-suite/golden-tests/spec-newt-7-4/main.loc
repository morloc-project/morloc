-- Spec NEWT-7: with a language where Bytes has no form of its own, the
-- unwrap runs there and the Python consumer receives a str.
module main (asStr)

import root-py
import root-cpp

newtype Bytes = Str
type Py => Bytes = "bytes"

source Py from "main.py" ("shout")
shout :: Str -> Str

asStr :: Bytes -> Str
asStr b = shout (unpack b)
