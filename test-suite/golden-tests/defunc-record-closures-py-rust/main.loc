-- Runtime closures nested in a record / list / tuple / optional / list-of-records
-- crossing a pool boundary. Producer: Python (reify). Consumer: Rust (reflect).
-- Exercises the Rust member's closure REFLECTION for every aggregate shape: Rust
-- reads each closure's wire tuple off the aggregate slot and rebuilds an
-- origin-preserving `Rc<dyn MorlocFnN>` FatClosure proxy that RPCs back to the
-- Python home pool on application (`call1`).
--
-- `crossListOfRecords` is the composition test (DA): the OUTER list is diverted
-- through the shared structural path while each INNER record is marshalled by its
-- own nominal ToVoidstar/FromVoidstar impl -- the two paths must interleave.
--
-- The captured `a`/`b` are runtime CLI arguments (not constant folded), so the
-- Python producer serializes genuinely captured values into each wire tuple.

module main
  ( crossRecord
  , crossList
  , crossTuple
  , crossOpt
  , crossListOfRecords
  )

import root-rust
import root-py

record Ops where
  inc :: Int -> Int
  scale :: Int -> Int
record Py => Ops = "dict"
record Rust => Ops = "Ops"

type Rust => Int = "i64"

source Py from "producer.py" ("tick", "add", "mul")
source Rust from "consumer.rs"
  ( "use_ops" as useOps
  , "use_list" as useList
  , "use_tuple" as useTuple
  , "use_opt" as useOpt
  , "use_list_of_records" as useLor
  )

tick :: <IO> Int
add :: Int -> Int -> Int
mul :: Int -> Int -> Int

useOps :: Ops -> Int -> Int
useList :: [Int -> Int] -> Int -> Int
useTuple :: (Int -> Int, Int -> Int) -> Int -> Int
useOpt :: ?(Int -> Int) -> Int -> Int
useLor :: [Ops] -> Int -> Int

mkOps :: Int -> Int -> <IO> Ops
mkOps a b = do
  _ <- tick
  { inc = (\x -> add a x), scale = (\x -> mul b x) }

crossRecord :: Int -> Int -> <IO> Int
crossRecord a b = do
  ops <- mkOps a b
  useOps ops 10

crossList :: Int -> Int -> <IO> Int
crossList a b = do
  _ <- tick
  useList [(\x -> add a x), (\x -> mul b x)] 10

crossTuple :: Int -> Int -> <IO> Int
crossTuple a b = do
  _ <- tick
  useTuple ((\x -> add a x), (\x -> mul b x)) 10

crossOpt :: Int -> <IO> Int
crossOpt a = do
  _ <- tick
  useOpt (\x -> add a x) 10

crossListOfRecords :: Int -> Int -> <IO> Int
crossListOfRecords a b = do
  ops1 <- mkOps a b
  ops2 <- mkOps a b
  useLor [ops1, ops2] 10
