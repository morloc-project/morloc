-- Runtime closures nested in a record / list / tuple / optional crossing a pool
-- boundary between two STATICALLY typed pools. Producer: Rust (reify). Consumer:
-- C++ (reflect). Rust boxes each closure into `Rc<dyn MorlocFnN>`, reifies it in
-- place into the wire tuple; C++ reflects each into a std::function proxy that
-- RPCs back to the Rust home pool. Exercises Rust<->C++ (static peer) interop for
-- every aggregate shape -- the wire form is language-agnostic (t3sjaau1).
--
-- The captured `a`/`b` are runtime CLI arguments (not constant folded), so the
-- Rust producer serializes genuinely captured values into each wire tuple.

module main (crossRecord, crossList, crossTuple, crossOpt)

import root-rust
import root-cpp

record Ops where
  inc :: Int -> Int
  scale :: Int -> Int
record Rust => Ops = "Ops"
record Cpp => Ops = "Ops"

type Rust => Int = "i64"
type Cpp => Int = "int"

source Rust from "producer.rs" ("tick", "add", "mul")
source Cpp from "consumer.hpp" ("useOps", "useList", "useTuple", "useOpt")

tick :: <IO> Int
add :: Int -> Int -> Int
mul :: Int -> Int -> Int

useOps :: Ops -> Int -> Int
useList :: [Int -> Int] -> Int -> Int
useTuple :: (Int -> Int, Int -> Int) -> Int -> Int
useOpt :: ?(Int -> Int) -> Int -> Int

mkOps :: Int -> Int -> <IO> Ops
mkOps a b = do
  _ <- tick
  { inc = (\x -> add a x), scale = (\x -> mul b x) }

crossRecord :: Int -> Int -> <IO> Int
crossRecord a b = do
  ops <- mkOps a b
  useOps ops 10

crossList :: Int -> Int -> <IO> Int
crossList a b = do
  _ <- tick
  useList [(\x -> add a x), (\x -> mul b x)] 10

crossTuple :: Int -> Int -> <IO> Int
crossTuple a b = do
  _ <- tick
  useTuple ((\x -> add a x), (\x -> mul b x)) 10

crossOpt :: Int -> <IO> Int
crossOpt a = do
  _ <- tick
  useOpt (\x -> add a x) 10
