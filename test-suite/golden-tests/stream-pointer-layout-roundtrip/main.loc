-- Values whose voidstar layout holds relative pointers, carried through
-- every stream-file and data-file path, must read back unchanged.
--
-- Report: "Sum-type values written with @write read back as garbage".
--
-- Each shape is written with the paths below and compared against its
-- in-memory rendering (the *Echo command):
--   Stream     @write level 0, @next             (uncompressed sub-packet)
--   StreamZ    @write level 3, @next             (compressed sub-packet)
--   Coalesce   two @write, no @flush, @load      (write-buffer compaction)
--   Flush      two @write with @flush, @load     (multi sub-packet @load)
--   Idx/Slice  stream file opened as IFile [T], .[2] / .[0:3]
--   Save*      @save data packet, @load / .[2] / .[0:3]
--   Append     @write, @close, @append, @write, @load
--   Concat     two stream files, @concat, @load
--
-- Shapes cover every place a pointer can sit relative to the start of a
-- record: a variant slot (bare, nested, recursive, in a tuple, a record,
-- an optional, a list, before and after a string field, with a nullary
-- arm first) and records whose first element owns no sub-allocation
-- ("", [], Null) with no variant anywhere. Enum, ?Real and (Int, Str)
-- are pointer-layout controls.

module main (shapeEcho, shapeStream, shapeStreamZ, shapeCoalesce, shapeFlush, shapeIdx, shapeSlice, shapeSave, shapeSaveIdx, shapeSaveSlice, shapeAppend, shapeConcat, tokEcho, tokStream, tokStreamZ, tokCoalesce, tokFlush, tokIdx, tokSlice, tokSave, tokSaveIdx, tokSaveSlice, tokAppend, tokConcat, bagEcho, bagStream, bagStreamZ, bagCoalesce, bagFlush, bagIdx, bagSlice, bagSave, bagSaveIdx, bagSaveSlice, bagAppend, bagConcat, treeEcho, treeStream, treeStreamZ, treeCoalesce, treeFlush, treeIdx, treeSlice, treeSave, treeSaveIdx, treeSaveSlice, treeAppend, treeConcat, wrapEcho, wrapStream, wrapStreamZ, wrapCoalesce, wrapFlush, wrapIdx, wrapSlice, wrapSave, wrapSaveIdx, wrapSaveSlice, wrapAppend, wrapConcat, tupEcho, tupStream, tupStreamZ, tupCoalesce, tupFlush, tupIdx, tupSlice, tupSave, tupSaveIdx, tupSaveSlice, tupAppend, tupConcat, recEcho, recStream, recStreamZ, recCoalesce, recFlush, recIdx, recSlice, recSave, recSaveIdx, recSaveSlice, recAppend, recConcat, optEcho, optStream, optStreamZ, optCoalesce, optFlush, optIdx, optSlice, optSave, optSaveIdx, optSaveSlice, optAppend, optConcat, lstEcho, lstStream, lstStreamZ, lstCoalesce, lstFlush, lstIdx, lstSlice, lstSave, lstSaveIdx, lstSaveSlice, lstAppend, lstConcat, strvEcho, strvStream, strvStreamZ, strvCoalesce, strvFlush, strvIdx, strvSlice, strvSave, strvSaveIdx, strvSaveSlice, strvAppend, strvConcat, enumEcho, enumStream, enumStreamZ, enumCoalesce, enumFlush, enumIdx, enumSlice, enumSave, enumSaveIdx, enumSaveSlice, enumAppend, enumConcat, optrEcho, optrStream, optrStreamZ, optrCoalesce, optrFlush, optrIdx, optrSlice, optrSave, optrSaveIdx, optrSaveSlice, optrAppend, optrConcat, tstrEcho, tstrStream, tstrStreamZ, tstrCoalesce, tstrFlush, tstrIdx, tstrSlice, tstrSave, tstrSaveIdx, tstrSaveSlice, tstrAppend, tstrConcat, estrEcho, estrStream, estrStreamZ, estrCoalesce, estrFlush, estrIdx, estrSlice, estrSave, estrSaveIdx, estrSaveSlice, estrAppend, estrConcat, elstEcho, elstStream, elstStreamZ, elstCoalesce, elstFlush, elstIdx, elstSlice, elstSave, elstSaveIdx, elstSaveSlice, elstAppend, elstConcat, eoptEcho, eoptStream, eoptStreamZ, eoptCoalesce, eoptFlush, eoptIdx, eoptSlice, eoptSave, eoptSaveIdx, eoptSaveSlice, eoptAppend, eoptConcat, etupEcho, etupStream, etupStreamZ, etupCoalesce, etupFlush, etupIdx, etupSlice, etupSave, etupSaveIdx, etupSaveSlice, etupAppend, etupConcat, enulEcho, enulStream, enulStreamZ, enulCoalesce, enulFlush, enulIdx, enulSlice, enulSave, enulSaveIdx, enulSaveSlice, enulAppend, enulConcat, vfstEcho, vfstStream, vfstStreamZ, vfstCoalesce, vfstFlush, vfstIdx, vfstSlice, vfstSave, vfstSaveIdx, vfstSaveSlice, vfstAppend, vfstConcat)
import root

data Shape = Circle Real | Rect Real Real
data Tok = Eof | Num Int | Word Str
data Bag = Bag [Int] | Empty
data Tree = Leaf | Node Int Tree Tree
data Wrap = W Shape | Nope
data Color = Red | Green | Blue
record Item where
  iid :: Int
  shape :: Shape

shapeVals :: [Shape]
shapeVals = [Circle 1.5, Rect 2.0 3.0, Circle 4.25]

shapeEcho :: Int -> [Shape]
shapeEcho n = shapeVals

shapeStream :: Str -> <IO> [Shape]
shapeStream p = do
  Ok o <- @open p :: <IO> (Try Str (OStream (Shape)))
  @write 0 o shapeVals
  @close o
  Ok s <- @open p :: <IO> (Try Str (IStream (Shape)))
  Ok xs <- @next s
  xs

shapeStreamZ :: Str -> <IO> [Shape]
shapeStreamZ p = do
  Ok o <- @open p :: <IO> (Try Str (OStream (Shape)))
  @write 3 o shapeVals
  @close o
  Ok s <- @open p :: <IO> (Try Str (IStream (Shape)))
  Ok xs <- @next s
  xs

shapeCoalesce :: Str -> <IO> [Shape]
shapeCoalesce p = do
  Ok o <- @open p :: <IO> (Try Str (OStream (Shape)))
  @write 0 o shapeVals
  @write 0 o shapeVals
  @close o
  Ok xs <- @load p :: <IO> (Try Str [Shape])
  xs

shapeFlush :: Str -> <IO> [Shape]
shapeFlush p = do
  Ok o <- @open p :: <IO> (Try Str (OStream (Shape)))
  @write 0 o shapeVals
  @flush o
  @write 0 o shapeVals
  @close o
  Ok xs <- @load p :: <IO> (Try Str [Shape])
  xs

shapeIdx :: Str -> <IO> Shape
shapeIdx p = do
  Ok o <- @open p :: <IO> (Try Str (OStream (Shape)))
  @write 0 o shapeVals
  @close o
  Ok f <- @open p :: <IO> (Try Str (IFile [Shape]))
  .[2] f

shapeSlice :: Str -> <IO> [Shape]
shapeSlice p = do
  Ok o <- @open p :: <IO> (Try Str (OStream (Shape)))
  @write 0 o shapeVals
  @close o
  Ok f <- @open p :: <IO> (Try Str (IFile [Shape]))
  .[0:3] f

shapeSave :: Str -> <IO> [Shape]
shapeSave p = do
  @save 0 p shapeVals
  Ok xs <- @load p :: <IO> (Try Str [Shape])
  xs

shapeSaveIdx :: Str -> <IO> Shape
shapeSaveIdx p = do
  @save 0 p shapeVals
  Ok f <- @open p :: <IO> (Try Str (IFile [Shape]))
  .[2] f

shapeSaveSlice :: Str -> <IO> [Shape]
shapeSaveSlice p = do
  @save 0 p shapeVals
  Ok f <- @open p :: <IO> (Try Str (IFile [Shape]))
  .[0:3] f

shapeAppend :: Str -> <IO> [Shape]
shapeAppend p = do
  Ok o <- @open p :: <IO> (Try Str (OStream (Shape)))
  @write 0 o shapeVals
  @close o
  Ok o2 <- @append p :: <IO> (Try Str (OStream (Shape)))
  @write 0 o2 shapeVals
  @close o2
  Ok xs <- @load p :: <IO> (Try Str [Shape])
  xs

shapeConcat :: Str -> <IO> [Shape]
shapeConcat p = do
  Ok a <- @open "#{p}.a" :: <IO> (Try Str (OStream (Shape)))
  @write 0 a shapeVals
  @close a
  Ok b <- @open "#{p}.b" :: <IO> (Try Str (OStream (Shape)))
  @write 0 b shapeVals
  @close b
  @concat ["#{p}.a", "#{p}.b"] p
  Ok xs <- @load p :: <IO> (Try Str [Shape])
  xs

