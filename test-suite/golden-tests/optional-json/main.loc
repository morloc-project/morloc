module main
  ( echoOptInt
  , echoOptStr
  , echoOptList
  , fromNullInt
  , isNullInt
  , readOpt
  )

type Py => Int = "int"
type Py => Bool = "bool"
type Py => Str = "str"
type Py => List a = "list" a

identity :: a -> a
fromNull :: a -> ?a -> a
isNull :: ?a -> Bool

source Py from "foo.py" ("identity", "fromNull", "isNull")

echoOptInt :: ?Int -> ?Int
echoOptInt x = identity x


-- A quoted argument cannot carry a null: `null` on the command line is the
-- three-letter string. Omitting the argument is how a null Str is written, and
-- an optional argument may always be omitted.
echoOptStr :: ?Str -> ?Str
echoOptStr x = identity x

echoOptList :: ?[Int] -> ?[Int]
echoOptList x = identity x

fromNullInt :: ?Int -> Int
fromNullInt x = fromNull 0 x

isNullInt :: ?Int -> Bool
isNullInt x = isNull x

-- An omitted argument has no token for `source: file` to interpret. Reading the
-- stand-in null as a path would send the runtime looking for a file of that
-- name, so an absent argument is dispatched without the argument's shape.
readOpt ::
  --' @metavar FILE
  --' @source file
  ?Str ->
  ?Str
readOpt x = identity x
