--' The same shape with a Nat-kinded parameter. The dimension-fixed instance
--' covers vectors of three; a use site carrying four falls back to the generic
--' instance rather than failing. See reports/0049.

module natGeneric (howVec4)

import root-py

newtype Vec n a

type Py => (Vec n a) = "dict" n a

instance Packable [a] (Vec n a) where
  source Py from "helpers.py" ("pack_generic" as pack, "unpack_generic" as unpack)

instance Packable [Int] (Vec 3 Int) where
  source Py from "helpers.py" ("pack_special" as pack, "unpack_special" as unpack)

source Py from "helpers.py" ("how" as how)

how :: Vec n a -> Str

howVec4 :: Vec 4 Int -> Str
howVec4 = how
