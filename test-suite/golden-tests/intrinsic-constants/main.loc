module main (langstr)

import root
import root-py (idpy)
import root-cpp (idcpp)
import root-r (idr)

-- @load raises Err on missing file; @catch substitutes an empty list.
-- The two round-tripped loads both succeed; the "zany" load is missing
-- and falls through to the empty-list fallback.
langstr :: <IO> ([Str],[Str],[Str])
langstr = do
  @save  0 "z" (idpy ["hi", @lang])
  @savej "zj" (idpy ["hi", @lang])
  Ok xs  <- @load "z"
  Ok zs  <- @load "zj"
  _bad <- @load "zany"
  let bad = match _bad | (Ok v) = v | (Err _) = []
  (xs, zs, bad)
