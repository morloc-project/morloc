-- @catch on the migrated fallible I/O intrinsics. Every intrinsic
-- that gained in the effect-row migration is exercised via a
-- fallible + fallback pair; the fallible path always fails (missing
-- file, malformed content, etc.) so the fallback value is what the
-- nexus returns.

module main
  ( catchLoad
  , catchLoadFallbackChain
  , catchRead
  , catchOpen
  , catchOpenTypedIStream
  , catchFschema
  , catchLoadNested
  , directOpenSucceeds
  )

-- `Try` is declared in `internal` and reaches user code through `root`;
-- a fallible intrinsic or `@try` needs it in scope.
import root

effect IO, Err

-- @load a nonexistent file, catch, return a default value. @catch
-- strips only Err; the residual <IO> propagates to the signature.
catchLoad :: Int -> <IO> Int
catchLoad def = do
  _mr <- @load "/tmp/intrinsic-io-catch-missing-XYZ.dat" :: <IO> (Try Str (Int))
  match _mr | (Ok _cv) = _cv | (Err _) = def

-- Nested @catch: primary fails, fallback also fails, catch again.
catchLoadFallbackChain :: <IO> Int
catchLoadFallbackChain = do
  _mr1 <- @load "/tmp/io-catch-nope-1.dat" :: <IO> (Try Str (Int))
  _mr2 <- @load "/tmp/io-catch-nope-2.dat" :: <IO> (Try Str (Int))
  match _mr1
    | (Ok v) = v
    | (Err _) = match _mr2 | (Ok w) = w | (Err _) = 999

-- @read is -only (no IO); the strip leaves no effect.
catchRead :: Str -> Int
catchRead def_str = match (@read "not valid json" :: Try Str (Int)) | (Ok _cv) = _cv | (Err _) = 7

-- @open of a missing file, catch. Return a sentinel string.
catchOpen :: <IO> Str
catchOpen =
  do
    _tr <- @try (do
      Ok _ <- @open "/tmp/io-catch-missing-XYZ.dat" :: <IO> (Try Str ((IFile Int)))
      "opened")
    match _tr | (Ok _cv) = _cv | (Err _) = "missing"

-- @open IStream on a missing file, catch.
catchOpenTypedIStream :: <IO> Str
catchOpenTypedIStream =
  do
    _tr <- @try (do
      Ok _ <- @open "/tmp/io-catch-nope-stream.dat" :: <IO> (Try Str ((IStream Int)))
      "stream-ok")
    match _tr | (Ok _cv) = _cv | (Err _) = "stream-missing"

-- @fschema on a missing file, catch.
catchFschema :: <IO> Str
catchFschema = do
  _mr <- @fschema "/tmp/io-catch-fschema-missing.dat" :: <IO> (Try Str (Str))
  match _mr | (Ok _cv) = _cv | (Err _) = "fschema-fallback"

-- Nested @catch: the fallback is itself a @catch on a fallible
-- expression. When the primary and the secondary both fail, the
-- innermost sentinel is what surfaces. This is the natural shape
-- for tiered fallback -- each fallible tier must be Err-stripped
-- (by its own @catch) before appearing as the fallback of the tier
-- above.
catchLoadNested :: <IO> Int
catchLoadNested = do
  _mr1 <- @load "/tmp/io-catch-inner-nope-1.dat" :: <IO> (Try Str (Int))
  _mr2 <- @load "/tmp/io-catch-inner-nope-2.dat" :: <IO> (Try Str (Int))
  match _mr1
    | (Ok v) = v
    | (Err _) = match _mr2 | (Ok w) = w | (Err _) = 77

-- Sanity check: a working path succeeds, no @catch needed at the top
-- level (Err escapes to the export signature, which declares it).
directOpenSucceeds :: Str -> <IO> Str
directOpenSucceeds path = do
  @save 0 path "morloc-payload"
  Ok s <- @load path :: <IO> (Try Str (Str))
  s
