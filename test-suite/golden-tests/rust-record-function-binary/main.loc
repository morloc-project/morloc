module main (apply2)

import root-rust

source Rust from "own.rs" ("add" as add)
add :: Int -> Int -> Int

-- A record with a TWO-ARGUMENT function field (the field type
-- `Arc<dyn Fn(&i64, &i64) -> i64 + Send + Sync>`, called as `f(&a, &b)`). The
-- extracted field `f` is applied inside a larger expression, so `f a b` is
-- lowered into its own manifold; that manifold's function parameter must accept
-- the function value itself (typed `&Arc<dyn Fn(..)>`, not `&impl Fn`).
record BinOp where
  op :: Int -> Int -> Int
  seed :: Int
record Rust => BinOp = "struct"

apply2 :: Int -> Int -> Int
apply2 a b =
  let bo = ({op = add, seed = a} :: BinOp) in
  let ({op = f, seed = s}) = bo in
  add (f a b) s
