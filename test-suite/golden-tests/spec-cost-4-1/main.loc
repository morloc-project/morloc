-- A function handed to a sourced function is called by it many times, by
-- default 1000 per call (COST-4). Here a fold and the addition it calls
-- both exist in Python and C++, and the sum goes to Python. Priced as one
-- call, the fold would stay in Python beside its consumer; priced as 1000
-- calls, it runs in C++ with its callback, crossing once. The placement
-- listing of `morloc typecheck --realize` is the output; the run checks
-- the program still computes.

--' Callbacks priced by their call count
module main (total)

import root-py
import root-cpp

source Py from "f.py" ("left_fold" as fold, "plus" as add, "show")
source Cpp from "f.hpp" ("left_fold" as fold, "plus" as add)

--' Combine a list from the left
fold :: (b -> a -> b) -> b -> [a] -> b

--' Add two integers
add :: Int -> Int -> Int

--' Render an integer
show :: Int -> Str

--' Sum a list and render the sum
total :: [Int] -> Str
total xs = show (fold add 0 xs)
