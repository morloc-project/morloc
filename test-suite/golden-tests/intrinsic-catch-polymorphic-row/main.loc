-- @try composed through a helper whose body carries a polymorphic effect
-- row. The property under test is that a bare-value alternative can be
-- checked into a slot whose type is an unsolved existential under an
-- effect row: without an existential-into-EffectU subtype rule, `fb :: b`
-- checked against `<e> b` triggers an occurs check at InstantiateL.
--
-- This used to be an @catch test whose fallible carried `<e, Err>`. Err is
-- no longer an effect -- failure is a `Try` value -- so the row here is
-- just `<e>` and the recovery is a match on the Try.

module main

  ( catchIntLoadFallback
  , catchIntLoadPrimary
  )

import root
import root-py

-- `f x` may perform any effects `e`; the result is a Try the caller
-- unwraps, falling back to `fb`.
withTry :: (a -> <e> (Try Str b)) -> a -> b -> <e> b
withTry f x fb = do
  r <- f x
  match r
    | (Ok v) = v
    | (Err _) = fb

tryLoad :: Str -> <IO> (Try Str Int)
tryLoad path = @load path

catchIntLoadFallback :: <IO> Int
catchIntLoadFallback =
  withTry tryLoad "/tmp/poly-catch-no-such-file.dat" -1

catchIntLoadPrimary :: Str -> <IO> Int
catchIntLoadPrimary path =
  withTry tryLoad path 0
