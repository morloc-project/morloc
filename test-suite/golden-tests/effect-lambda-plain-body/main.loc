-- A lambda at a slot typed `Int -> <IO> Int` must return a suspension, so a
-- body that is a literal, a bound parameter or a let binding is written
-- `do v`: a constant suspension. The host receives the callback through the
-- eager adapter, so `f(x)` runs the suspension and yields the value; the
-- host never sees a thunk it must call itself.
--
-- Every function below returns <IO>. Both a bare higher-order argument and a
-- record field are covered, because neither requires the other, and both a
-- language that boxes closures (Rust) and one that does not (Python).
module main
  ( argLiteral
  , argParam
  , argLet
  , argEffectful
  , recParam
  , rustArgParam
  , rustRecParam
  )

import root-py
import root-rust

record Ops where
  inc :: Int -> <IO> Int
  same :: Int -> <IO> Int
record Py => Ops = "dict"
record Rust => Ops = "Ops"

type Rust => Int = "i64"

source Py from "host.py" ("apply_fn" as applyF, "use_ops" as useOps, "tick")
source Rust from "host.rs" ("rs_apply_fn" as rsApplyF, "rs_use_ops" as rsUseOps)

applyF :: (Int -> <IO> Int) -> Int -> <IO> Int
useOps :: Ops -> Int -> <IO> Int
tick :: Int -> <IO> Int
rsApplyF :: (Int -> <IO> Int) -> Int -> <IO> Int
rsUseOps :: Ops -> Int -> <IO> Int

-- a constant suspension of a literal
argLiteral :: Int -> <IO> Int
argLiteral k = applyF (\x -> do 42) k

-- a constant suspension of the bound parameter
argParam :: Int -> <IO> Int
argParam k = applyF (\x -> do x) k

-- and of a let-bound value
argLet :: Int -> <IO> Int
argLet k = applyF (\x -> let y = x in do y) k

-- a body that is itself a suspension
argEffectful :: Int -> <IO> Int
argEffectful k = applyF (\x -> tick x) k

recParam :: Int -> <IO> Int
recParam k = useOps { inc = (\x -> tick x), same = (\x -> do x) } k

rustArgParam :: Int -> <IO> Int
rustArgParam k = rsApplyF (\x -> do x) k

rustRecParam :: Int -> <IO> Int
rustRecParam k = rsUseOps { inc = (\x -> do x), same = (\x -> do x) } k
