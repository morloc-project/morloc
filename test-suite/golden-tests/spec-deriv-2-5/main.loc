-- Spec DERIV-2: derived Eq, Ord, Show and Hashable act on the wire value,
-- with the same results in every language, here in the nexus.
module main (checks, texts)

import root

newtype Name = Str
  deriving (Eq, Ord, Show, Hashable)

data Shape = Circle Real | Rect Real Real | Dot
  deriving (Eq, Ord, Show)

record Point
  deriving (Eq, Ord, Show)
  where
  x :: Int
  y :: Int

checks :: [Bool]
checks =
  [ ("ab" :: Name) == ("ab" :: Name)
  , ("ab" :: Name) <= ("b" :: Name)
  , (Circle 1.0) == Circle 1.0
  , (Rect 1.0 2.0) <= Rect 1.0 1.0
  , Circle 5.0 <= Dot
  , ({x = 1, y = 2} :: Point) <= ({x = 1, y = 3} :: Point)
  ]

texts :: [Str]
texts =
  [ show ("ab" :: Name)
  , show (Rect 1.0 2.0)
  , hash ("ab" :: Name)
  ]
