-- A docstring above an item of a tuple-form `source` list belongs to that
-- item (DOC-1), whether it sits directly above the item, above the comma
-- before it, or above the opening parenthesis. Each Python addition with
-- `@selftime 1ns` stays in Python beside `show`; one with nothing stated
-- takes the 1 us default and its chain runs in C++. `addPlain` is the item
-- before a commented comma: it keeps the default, so the comma's docstring
-- went to the item after it, not the one before.

--' Self time stated on items of tuple-form source lists
module main (byComma, byPlain, byParen, byItem)

import root-py
import root-cpp

source Py from "f.py"
  ( "show"
  , "plus" as addPlain
  --' @selftime 1ns
  , "plus" as addComma
  )

source Py from "f.py" (
  --' @selftime 1ns
  "plus" as addItemAbove
  )

source Py from "f.py"
  --' @selftime 1ns
  ("plus" as addParen)

source Cpp from "f.hpp"
  ( "plus" as addPlain
  , "plus" as addComma
  , "plus" as addItemAbove
  , "plus" as addParen
  )

--' Add two integers
addPlain :: Int -> Int -> Int
--' Add two integers
addComma :: Int -> Int -> Int
--' Add two integers
addItemAbove :: Int -> Int -> Int
--' Add two integers
addParen :: Int -> Int -> Int

--' Render an integer
show :: Int -> Str

--' Sum with the time stated above a comma
byComma :: Int -> Str
byComma x = show (addComma (addComma (addComma x 1) 2) 3)

--' Sum with no time stated on the item before that comma
byPlain :: Int -> Str
byPlain x = show (addPlain (addPlain (addPlain x 1) 2) 3)

--' Sum with the time stated above an opening parenthesis
byParen :: Int -> Str
byParen x = show (addParen (addParen (addParen x 1) 2) 3)

--' Sum with the time stated directly above the item
byItem :: Int -> Str
byItem x = show (addItemAbove (addItemAbove (addItemAbove x 1) 2) 3)
