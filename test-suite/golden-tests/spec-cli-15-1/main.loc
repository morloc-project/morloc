-- Spec CLI-15: the header decides the delimiter, whatever the file is
-- called: TAB in a .csv file, commas in a .txt file, a byte-order mark,
-- quoted names, CRLF line ends, and a header that splits on only one
-- delimiter.
module main (rows, table, open)

import root-py
import table-py

source Py from "src.py" ("py_id")
py_id :: a -> a

record Row = Row { x :: Int, y :: Str }

--' Records as read, through a Python pool
rows ::
  --' @form table
  [Row] -> [Row]
rows xs = py_id xs

--' A table as read, through a Python pool
table ::
  --' @form table
  Table n {x=Int, y=Str} -> Table n {x=Int, y=Str}
table t = py_id t

--' A table of any columns, through a Python pool
open ::
  --' @form table
  Table n r -> Table n r
open t = py_id t
