-- `@dimension` names the element counts of a signature's arguments and
-- result, and a self time written in those names follows the size of the
-- data at each call (COST-5, COST-7, COST-8). `incr` costs 100 ns per element
-- and exists in Python and C++; `total`, which consumes its result, only in
-- Python. On a three-element literal the Python `incr` is cheaper than a
-- crossing; on the million elements `countUp` states for its result, the
-- C++ one is, by more than the crossing, also when the list reaches it
-- through a let. badname.loc gives a source its own self time in a name
-- its signature does not introduce, which is rejected. The placement listing is the
-- output; the run checks the program still computes.

--' Self times that grow with the data
module main (small, large, viaLet)

import root-py
import root-cpp

source Py from "f.py" ("incr", "total", "count_up" as countUp)
source Cpp from "f.hpp" ("incr")

--' Add one to each element
--' @selftime 100ns * n
incr ::
  --' The numbers
  --' @dimension n
  [Int] ->
  --' @dimension n
  [Int]

--' Render the sum of a list
total :: [Int] -> Str

--' The numbers from zero
countUp ::
  Int ->
  --' @dimension 1000000
  [Int]

--' Add one to a short list
small :: Int -> Str
small x = total (incr [x, 2, 3])

--' Add one to a long list
large :: Int -> Str
large k = total (incr (countUp k))

--' Add one to a long list bound by a let
viaLet :: Int -> Str
viaLet k = total (let ys = countUp k in incr ys)
