vfstVals :: [(Shape, Str)]
vfstVals = [(Circle 1.5, "a"), (Rect 2.0 3.0, "bc"), (Circle 4.25, "d")]

vfstReadCpp :: Str -> <IO> [(Shape, Str)]
vfstReadCpp p = do
  Ok o <- @open p :: <IO> (Try Str (OStream ((Shape, Str))))
  @write 0 o vfstVals
  @close o
  Ok s <- @open p :: <IO> (Try Str (IStream ((Shape, Str))))
  Ok xs <- @next s
  idCpp xs

vfstWriteCpp :: Str -> <IO> [(Shape, Str)]
vfstWriteCpp p = do
