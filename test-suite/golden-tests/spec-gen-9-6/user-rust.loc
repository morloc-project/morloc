-- GEN-9: a user-mapped recursive template record used at an argument
-- holding itself is spelled at that argument.
module main (nest, innerVal)

import root-rust

record L a where
  val :: a
  next :: ?(L a)
record Rust => L a = "MyL<$1>"

source Rust from "user.rs" ("same", "innerL")
same :: a -> a
innerL :: L (L Int) -> Int

nest :: L (L Int) -> L (L Int)
nest x = same x

innerVal :: L (L Int) -> Int
innerVal x = innerL x
