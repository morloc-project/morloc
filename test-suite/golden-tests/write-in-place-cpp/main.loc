-- C++ writes each batch in place (SLOT-36, SLOT-37) and Python from a
-- voidstar copy that the runtime lays out. Both write the same
-- JSON batches, and the two files must agree byte for byte, sub-packet cuts
-- and footer included, apart from the writer's pid and times (same.py).
-- The types cover alignment relative to the element's origin, empty arrays
-- and strings, size slack, records and data arms with deep fields before
-- fields with tails (Tree, Chain: laid out in field order), and a rose
-- tree 10000 deep. The 4096-byte buffer cuts most batches.
module main
  ( wcReal, wpReal
  , wcI8, wpI8
  , wcBool, wpBool
  , wcPair, wpPair
  , wcI64, wpI64
  , wcInt, wpInt
  , wcStr, wpStr
  , wcReals, wpReals
  , wcI8s, wpI8s
  , wcU8s, wpU8s
  , wcStrs3, wpStrs3
  , wcOptStr, wpOptStr
  , wcOptReals, wpOptReals
  , wcOptI16s, wpOptI16s
  , wcDir, wpDir
  , wcShape, wpShape
  , wcTwo, wpTwo
  , wcMixed, wpMixed
  , wcTree, wpTree
  , wcRose, wpRose
  , wcChain, wpChain
  )

import root
import root-cpp
import root-py

data Dir = North | South | East

record Pt where
  x :: Real
  label :: Str

data Shape = Dot | Circle Real | Box Pt

record Two where
  name :: Str
  tag :: U8
  xs :: [I16]
  more :: [Str]

data Tree = Leaf | Node Int Tree Tree

data Rose = Rose I32 [Rose]

-- A deep field before fields with tails: laid out in field order.
data Chain = End | Link Str Chain [I8] Str

drainC :: Int -> OStream a -> [[a]] -> <IO> ()
drainC z o xss = do
  ? length xss == 0 = do
      ()
  : do
    @write z o (idcpp (.0 (uncons xss)))
    drainC z o (.1 (uncons xss))

drainP :: Int -> OStream a -> [[a]] -> <IO> ()
drainP z o xss = do
  ? length xss == 0 = do
      ()
  : do
    @write z o (idpy (.0 (uncons xss)))
    drainP z o (.1 (uncons xss))

wcReal :: Int -> Str -> [[Real]] -> <IO> ()
wcReal z path xss = do
  Ok o <- @open path :: <IO> (Try Str (OStream Real))
  drainC z o xss
  @close o

wpReal :: Int -> Str -> [[Real]] -> <IO> ()
wpReal z path xss = do
  Ok o <- @open path :: <IO> (Try Str (OStream Real))
  drainP z o xss
  @close o

