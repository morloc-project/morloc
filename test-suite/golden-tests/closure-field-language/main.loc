-- A record, list or tuple of function values lives in the language of the
-- pool that consumes it, and so do the function values it holds: a closure
-- reaches any other pool from inside its body. Here every closure body
-- wants the other pool (it calls a function sourced only there), and the
-- record is handed to a host in this one. The closure must be homed with
-- the record and call across from its body, rather than be realized in
-- the other language and left inside the record with no crossing -- which
-- lands a foreign manifold in the wrong pool, so the Python pool fails to
-- import a Rust source and the Rust pool renders a Python source.
--
-- Both directions, with a suspension field alongside the lambdas whose
-- body is in the host's language. A suspension field whose body is in the
-- other language is the subject of `suspension-field-foreign-body`.

module main (pyHost, rustHost)

import root-py
import root-rust

record Ops where
  inc :: Int -> Int
  total :: <IO> Int
record Py => Ops = "dict"
record Rust => Ops = "Ops"

type Rust => Int = "i64"

source Py from "host.py" ("py_double" as pyDouble, "py_tick" as pyTick, "py_use_ops" as pyUseOps)
source Rust from "host.rs" ("rs_double" as rsDouble, "rs_tick" as rsTick, "rs_use_ops" as rsUseOps)

pyDouble :: Int -> Int
pyTick :: Int -> <IO> Int
pyUseOps :: Ops -> Int -> <IO> Int
rsDouble :: Int -> Int
rsTick :: Int -> <IO> Int
rsUseOps :: Ops -> Int -> <IO> Int

-- closures whose bodies are Rust, handed to a Python host
rustOps :: Int -> Ops
rustOps k = { inc = (\x -> rsDouble x + k), total = pyTick k }

pyHost :: Int -> Int -> <IO> Int
pyHost k n = pyUseOps (rustOps k) n

-- closures whose bodies are Python, handed to a Rust host
pyOps :: Int -> Ops
pyOps k = { inc = (\x -> pyDouble x + k), total = rsTick k }

rustHost :: Int -> Int -> <IO> Int
rustHost k n = rsUseOps (pyOps k) n
