--' Following the advice: only the C++ adder is imported
module main (useInCpp)

import root-py
import root-cpp
import .helpers
import .cppadder

--' Make an adder from a Python value and use it in C++
useInCpp :: Int -> <IO> Int
useInCpp n = do
  h <- mkAdder (pyF n)
  cppSum (cppMap (\x -> cppF (h x)) [1, 2])
