-- Rust pool member: pattern accessors beyond plain getters.
--
-- Covers the rustEvalPattern cases that previously errored:
--   * string interpolation `"... #{x} ..."` (interweave_strings)
--   * a getter chain with bracket steps `.1.[i]` / `.1.[a:b]`
--   * a multi-sibling getter group `.(.0, .2)` -> a tuple
--   * record/tuple SETTERS `.(.field = v)` (rebuild with one leaf replaced;
--     the receiver is bound once and unchanged fields are cloned)
--   * a setter naming several fields in an order other than the declaration's,
--     over fields of one type, where nothing downstream can notice a swap
--
-- idrust forces the pattern evaluation into the Rust pool.
--
-- Rust because it imports root-rust; the spec is backend-agnostic.

module main
  ( greet
  , tupIdx
  , tupSlice
  , tupGroup
  , setX
  , setTup
  , setNested
  , setSwapped
  , setTupSwapped
  , setMixed
  , setBoth
  , setEta
  )

import root-rust

record Rec where
  x :: Int
  y :: Str
  z :: Int
record Rust => Rec = "struct"

record Rec2 where
  a :: Int
  p :: (Str, Int)
record Rust => Rec2 = "struct"

-- string interpolation
greet :: Str -> Str -> Str
greet name place = idrust "Hi #{name} from #{place}!"

-- index element i of the [Int] at tuple position .1
tupIdx :: (Str, [Int]) -> Int -> Int
tupIdx t i = idrust (.1.[i] t)

-- slice the [Int] at tuple position .1
tupSlice :: (Str, [Int]) -> Int -> Int -> [Int]
tupSlice t a b = idrust (.1.[a:b] t)

-- multi-sibling group of getters at the root -> a tuple
tupGroup :: (Int, Str, Int) -> (Int, Int)
tupGroup t = idrust (.(.0, .2) t)

-- record setter: replace one field, keep the rest
setX :: Rec -> Int -> Rec
setX r v = .(.x = v) (idrust r)

-- tuple setter: replace position 1
setTup :: (Int, Str, Int) -> Str -> (Int, Str, Int)
setTup t v = .(.1 = v) (idrust t)

-- nested setter: set element 0 of the tuple field .p
setNested :: Rec2 -> Str -> Rec2
setNested r v = .(.p.0 = v) (idrust r)

-- Both fields hold an Int and are named in the reverse of their declaration, so
-- a value paired with a field by position rather than by name lands on the
-- wrong one and nothing else in the program can tell.
setSwapped :: Rec -> Int -> Int -> Rec
setSwapped r u v = .(.z = u, .x = v) (idrust r)

-- The same for a tuple whose two set slots share a type.
setTupSwapped :: (Int, Str, Int) -> Int -> Int -> (Int, Str, Int)
setTupSwapped t u v = .(.2 = u, .0 = v) (idrust t)

-- Reversed order over fields of different types. Before the values were paired
-- by name this shape did not miscompile, it failed to compile: an Int landed in
-- a Str field and rustc said so. The non-Copy field also exercises the clone
-- that rebuilds an untouched field.
setMixed :: Rec -> Str -> Int -> Rec
setMixed r s n = .(.y = s, .x = n) (idrust r)

-- Two writes under one field. Matching the field name against a single
-- selector entry honours only the first, so the second write disappears.
setBoth :: Rec2 -> Str -> Int -> Rec2
setBoth r s n = .(.p.0 = s, .p.1 = n) (idrust r)

-- The setter reached through a higher-order call rather than applied directly.
setEta :: [Rec] -> Int -> [Rec]
setEta rs v = idrust (map .(.z = v, .x = v) rs)
