-- A Python list @write batch is written in place (SLOT-36, SLOT-37). With a
-- write-behind depth of 1, placements often find the queue full: they
-- return MLC_WRITE_WOULD_BLOCK, the writer waits without the GIL and
-- places again, in runs and in single rooms; at level 9 the custodian
-- is slowest. Each file is checked byte for byte, apart from the writer's
-- pid and times (same.py), against staged standard output
-- (MORLOC_STDOUT=stage, the voidstar copy), and against the same batches
-- given as bytes or numpy arrays, which take the copy path. A Bool batch
-- given as bytes holding a 2 fails and is absent.
module main (wReals, sReals, wI32s, sI32s, wI8s, sI8s, wU8s, sU8s, wBools, sBools, wI16s, sI16s, wStrs, sStrs, badBools, countBools)

import root
import root-py

source Py from "forms.py" ("reals", "i32s", "i8s", "u8s", "bools", "i16s", "strs", "bad_bools" as badBools_)

reals :: Str -> Int -> [Real]
i32s :: Str -> Int -> [I32]
i8s :: Str -> Int -> [I8]
u8s :: Str -> Int -> [U8]
bools :: Str -> Int -> [Bool]
i16s :: Str -> Int -> [I16]
strs :: Str -> Int -> [Str]
badBools_ :: Int -> Int -> [Bool]

dReals :: Int -> OStream Real -> Str -> [Int] -> <IO> ()
dReals z o kind ns = do
  ? length ns == 0 = do
      ()
  : do
    @write z o (reals kind (.0 (uncons ns)))
    dReals z o kind (.1 (uncons ns))

--' Write Reals batches of each size to a file
wReals :: Str -> Int -> Str -> <IO> ()
wReals kind z path = do
  Ok o <- @open path :: <IO> (Try Str (OStream Real))
  dReals z o kind [0, 1, 7, 5000, 3, 20000, 1]
  @close o

--' Write Reals batches of each size to standard output
sReals :: Str -> Int -> <IO> (Collect Real)
sReals kind z = @stdout (\o -> do
  dReals z o kind [0, 1, 7, 5000, 3, 20000, 1])

