--' Write Strs batches of each size to standard output
sStrs :: Str -> Int -> <IO> (Collect Str)
sStrs kind z = @stdout (\o -> do
  dStrs z o kind [0, 1, 7, 5000, 3, 20000, 1])

ok :: Try Str () -> Bool
ok r = match r
  | (Ok _) = True
  | (Err _) = False

--' Write three Bool batches as bytes, the second failing near its end
badBools :: Str -> <IO> [Bool]
badBools path = do
  Ok o <- @open path :: <IO> (Try Str (OStream Bool))
  a <- @write 0 o (badBools_ 5000 (-1))
  b <- @write 0 o (badBools_ 5000 4500)
  c <- @write 0 o (badBools_ 3000 (-1))
  @close o
  [ok a, ok b, ok c]

--' The number of Bools in a written file
countBools :: [Bool] -> Int
countBools xs = length xs
