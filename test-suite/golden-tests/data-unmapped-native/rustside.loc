module rustside (enums, variants, roundTrip, eqSame, eqDiff)

import .types
import root-rust

enums :: [Color]
enums = replicate 3 Green

variants :: [Box]
variants = replicate 2 (Wrap 1.5)

roundTrip :: [Box] -> [Box]
roundTrip xs = replicate (length xs) Empty

-- `Color` appears in neither signature, so the only thing that can tell the
-- pool its constructor table is the declaration. A table gathered from the
-- literals present would hold one arm and renumber every other constructor,
-- which is silent: the pool agrees with itself and disagrees with the wire.
-- Both use the LAST constructor, whose tag a truncated table moves to zero.
eqSame :: Bool
eqSame = Blue == Blue

eqDiff :: Bool
eqDiff = Blue == Red
