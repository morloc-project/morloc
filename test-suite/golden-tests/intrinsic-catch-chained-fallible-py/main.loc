module main
  ( chained
  , nested
  )

import root
import root-py

source Py from "helper.py"
  ( "loadA"
  , "loadB"
  , "loadC"
  )

loadA :: Int -> Int
loadB :: Int -> Int
loadC :: Int -> Int

chained :: Int -> Int
chained n = match (@try (loadA n)) | (Ok _cv) = _cv | (Err _) = (loadB n)

nested :: Int -> Int
nested n = match (@try (loadA n)) | (Ok _cv) = _cv | (Err _) = (match (@try (loadB n)) | (Ok _cv) = _cv | (Err _) = (match (@try (loadC n)) | (Ok _cv) = _cv | (Err _) = 999))
