module main (mk, same, dot, roll, rep, pairLen, firstOpt, opts, deep, grow, named)

import root-py
import vector-py

source Py from "src.py"
  ( "mk" as mk
  , "dot" as dot
  , "roll" as roll
  , "rep" as rep
  , "pair_len" as pairLen
  , "first_opt" as firstOpt
  , "opts_len" as optsLen
  , "deep" as deep
  , "grow" as grow
  , "named" as named
  )

--' Count up from zero
mk :: n@Int -> Vector n Int

--' Keep the first of two vectors of one length
same :: Vector n Int -> Vector n Int -> Vector n Int
same a b = a

--' Dot product
dot :: Vector n Int -> Vector n Int -> Int

--' Sums over a sliding window
roll :: w@Int -> Vector n Int -> Vector (n - w + 1) Int

--' Repeat a value
rep :: n@Int -> Int -> Vector n Int

--' Count the vectors of a pair's second part
pairLen :: (Vector n Int, [Vector n Int]) -> Int

--' Length of the first of an optional pair
firstOpt :: ?(Vector n Int, Vector n Int) -> Int

--' Two vectors
--' @unroll
record TwoOpts where
  --' Left values
  --' @arg --left
  --' @default []
  left :: Vector n Int
  --' Right values
  --' @arg --right
  --' @default []
  right :: Vector n Int

record Py => TwoOpts = "dict"

--' Length of the left vector
opts :: TwoOpts -> Int
opts o = optsLen o

optsLen :: TwoOpts -> Int

--' An entry
record Entry (n :: Nat) where
  --' Values
  a :: Vector n Int
  --' Tag
  b :: Int

record Py => Entry n = "dict"

--' Length of a vector the entries share
deep :: [Entry n] -> Vector n Int -> Int

--' Lengths of a vector and one a longer
grow :: Vector n Int -> Vector (n + 1) Int -> Int

--' A name
type Name = Str

--' Dot product under a name
named :: s@Name -> Vector n Int -> Vector n Int -> Int
