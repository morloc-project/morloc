-- Test that passing a big integer from Python to C++ produces a clear error.
-- fact(100) is a 525-bit integer that cannot fit in any C++ primitive. The
-- factorial is sourced from Python so it is computed with Python integers
-- wherever the realizer would place a morloc definition.
module main (factCpp)

import root-py
import root-cpp

source Py from "fact.py" ("fact")

fact :: Int -> Int

factPy :: Int -> Int
factPy n = idpy (fact n)

factCpp :: Int -> Int
factCpp x = idcpp (factPy x)
