-- Schema comparison at the stream-file boundary must ignore per-language
-- concrete-type hints.
--
-- A type whose general name is not a builtin base type gets a `<hint>`
-- prefix in the pool's schema string: a record declared `record py => T
-- = "dict"` becomes `a<dict>m...`, and `type Tag = Str` becomes
-- `a<str>s`. Every packet writer stores the hint-free form, so any
-- comparison that is a raw string equality against the pool's schema can
-- never match for such a type.
--
-- Every function here forces its body into the py pool (the list
-- operations come from root-py), which is what makes the pool's
-- hint-bearing schema the one that reaches the runtime. The same code
-- evaluated at the nexus takes a different path that normalizes first,
-- so a nexus-only version of this test passes even when the pool one
-- does not.
--
-- Two boundaries are covered because both compared schema strings
-- raw: `@append` on a file, and a stream arriving on stdin.

module main
  ( appendRecord
  , appendAlias
  , appendMany
  , readMismatch
  , produceEv
  , readEv
  )

import root-py

record Ev where
  kind :: Str
  id :: Int

record py => Ev = "dict"

record Other where
  alpha :: Str
  beta :: Int

record py => Other = "dict"

type Tag = Str

-- Record elements carry `<dict>`. Create, close, append, read back.
appendRecord :: Str -> <IO, Err> [Ev]
appendRecord path = do
  o <- @open path :: <IO, Err> OStream Ev
  @write 0 o (filter (\e -> .id e > 0) [{kind = "a", id = 1}])
  @close o
  o2 <- @append path :: <IO, Err> OStream Ev
  @write 0 o2 (filter (\e -> .id e > 0) [{kind = "b", id = 2}])
  @close o2
  f <- @open path :: <IO, Err> IFile [Ev]
  .[:] f

-- A `type X = Str` alias carries `<str>`, so hints are not a record-only
-- concern.
appendAlias :: Str -> <IO, Err> [Tag]
appendAlias path = do
  o <- @open path :: <IO, Err> OStream Tag
  @write 0 o (filter (\t -> size t > 0) ["one"])
  @close o
  o2 <- @append path :: <IO, Err> OStream Tag
  @write 0 o2 (filter (\t -> size t > 0) ["two"])
  @close o2
  f <- @open path :: <IO, Err> IFile [Tag]
  .[:] f

-- Repeated appends: the resume cursor must survive more than one round.
appendMany :: Str -> <IO, Err> Int
appendMany path = do
  o <- @open path :: <IO, Err> OStream Ev
  @write 0 o (filter (\e -> .id e > 0) [{kind = "a", id = 1}])
  @close o
  add path 2
  add path 3
  f <- @open path :: <IO, Err> IFile [Ev]
  @flen f
  where
    add :: Str -> Int -> <IO, Err> ()
    add p n = do
      o <- @append p :: <IO, Err> OStream Ev
      @write 0 o (filter (\e -> .id e > 0) [{kind = "z", id = n}])
      @close o

-- A record stream crossing stdin. The nexus compares the opener's
-- declared schema against the incoming packet's; the opener's carries
-- `<dict>` and the packet's does not.
produceEv :: Int -> [Ev]
produceEv n = filter (\e -> .id e > 0) [{kind = "p", id = n}, {kind = "q", id = n + 1}]

--' Read records from a file, or from stdin when the path is omitted.
readEv ::
  --' @stdin
  Str ->
  <IO, Err> [Ev]
readEv f = do
  s <- @open f :: <IO, Err> IStream Ev
  xs <- @next s
  filter (\e -> .id e > 0) xs

-- Ignoring the hint must not make the check vacuous: a genuinely
-- different element type is still a mismatch.
readMismatch :: Str -> <IO, Err> [Other]
readMismatch path = do
  o <- @open path :: <IO, Err> OStream Ev
  @write 0 o (filter (\e -> .id e > 0) [{kind = "a", id = 1}])
  @close o
  s <- @open path :: <IO, Err> IStream Other
  @next s
