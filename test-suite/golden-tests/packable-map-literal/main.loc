-- A list-of-tuples literal inhabits MyMap through its representation, and
-- the code generator wraps the wire-shaped value with the Python native
-- form's @pack@ source.

module main (mapSize)

import root-py

newtype MyMap a b = [(a, b)]
type Py => (MyMap a b) = "dict" a b

instance Packable (List (Tuple2 a b)) (MyMap a b) where
  source Py from "main.py"
   ( "pack_mymap" as pack
   , "unpack_mymap" as unpack
   )

source Py from "main.py" ("size_map" as sizeMap)
sizeMap :: MyMap Str Int -> Int

mapSize :: Int
mapSize = sizeMap [("a", 1), ("b", 2), ("c", 3)]
