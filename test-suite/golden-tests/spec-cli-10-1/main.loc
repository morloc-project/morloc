-- Spec CLI-10: an action whose handler has no docstring gets an empty
-- description slot in help; nothing else is put in its place.
module main (once)

import root

--' Text
shout :: [Int] -> Str
shout _ = "shout"

quiet :: [Int] -> Str
quiet _ = "quiet"

--' Numbers
--' @render -a/--shout=shout
--' @render -b/--quiet=quiet
once :: [Int]
once = [1,2,3]
