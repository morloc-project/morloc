-- Each batch of JSON values is written to a stream file in place by the
-- languages that hold its type (SLOT-36, SLOT-37) and checked byte for
-- byte, sub-packet cuts and footer included, apart from the writer's pid
-- and times (same.py):
--   * against the same language's staged standard output
--     (MORLOC_STDOUT=stage), which takes the voidstar copy: the runtime
--     flattens the language's own voidstar, so this pins placement (cuts,
--     slack, alignment relative to the element's origin) but not the
--     language's encoding choices;
--   * across languages, which pins those choices: C++ against Python for
--     every type, R against Python for every type (on inputs R can hold:
--     rsafe.py drops NUL from strings and moves -2^63, bit64's NA), Rust
--     against Python for 64-bit Int (Wide, with -2^63), and Python
--     against the nexus for Int beyond 64 bits (BigOne: the nexus writes a
--     batch it holds itself). R reads a batch of scalars as an atomic
--     vector, which takes the copy path, so those types are also written
--     from R as lists (asList), which go through runs in place.
-- The types cover alignment, empty arrays and strings, size slack,
-- records and data arms with deep fields before fields with tails (Tree,
-- Chain: laid out in field order), Int values needing limbs, and a rose
-- tree 10000 deep. The 4096-byte buffer cuts most batches; a few types
-- are also written with the default buffer.
module main
  ( wcReal, wrReal, wpReal
  , wcI8, wrI8, wpI8
  , wcBool, wrBool, wpBool
  , wcPair, wrPair, wpPair
  , wcI64, wrI64, wpI64
  , wcInt, wrInt, wpInt
  , wcStr, wrStr, wpStr
  , wcReals, wrReals, wpReals
  , wcI8s, wrI8s, wpI8s
  , wcU8s, wrU8s, wpU8s
  , wcStrs3, wrStrs3, wpStrs3
  , wcOptStr, wrOptStr, wpOptStr
  , wcOptReals, wrOptReals, wpOptReals
  , wcOptI16s, wrOptI16s, wpOptI16s
  , wcDir, wrDir, wpDir
  , wcShape, wrShape, wpShape
  , wcTwo, wrTwo, wpTwo
  , wcMixed, wrMixed, wpMixed
  , wcTree, wrTree, wpTree
  , wcRose, wrRose, wpRose
  , wcChain, wrChain, wpChain
  , wcUnits, wrUnits, wpUnits
  , wcUnit, wrUnit, wpUnit
  , wrWide, srWide, wpWide, spWide
  , wpBig, spBig, wnBigOne, wpBigOne
  , scReal, srReal, spReal
  , scI8, srI8, spI8
  , scBool, srBool, spBool
  , scPair, srPair, spPair
  , scI64, srI64, spI64
  , scInt, srInt, spInt
  , scReals, srReals, spReals
  , scI8s, srI8s, spI8s
  , scOptStr, srOptStr, spOptStr
  , scOptI16s, srOptI16s, spOptI16s
  , scDir, srDir, spDir
  , scTwo, srTwo, spTwo
  , scUnit, srUnit, spUnit
  , scStrs3, srStrs3, spStrs3
  , scTree, srTree, spTree
  , scMixed, srMixed, spMixed
  , scUnits, srUnits, spUnits
  , scChain, srChain, spChain
  , scRose, srRose, spRose
  , scShape, srShape, spShape
  , scOptReals, srOptReals, spOptReals
  , scU8s, srU8s, spU8s
  , scStr, srStr, spStr
  , wlReal
  , wlI8
  , wlBool
  , wlI64
  , wlInt
  , wlDir
  , wvReal, svReal
  , wvI8, svI8
  , wvBool, svBool
  , wvPair, svPair
  , wvI64, svI64
  , wvInt, svInt
  , wvStr, svStr
  , wvReals, svReals
  , wvI8s, svI8s
  , wvU8s, svU8s
  , wvStrs3, svStrs3
  , wvOptStr, svOptStr
  , wvOptReals, svOptReals
  , wvOptI16s, svOptI16s
  , wvDir, svDir
  , wvShape, svShape
  , wvTwo, svTwo
  , wvMixed, svMixed
  , wvTree, svTree
  , wvRose, svRose
  , wvChain, svChain
  , wvUnits, svUnits
  , wvUnit, svUnit
  )


import root
import root-cpp
import root-py
import root-rust
import root-r

source R from "aslist.R" ("as_list" as asList)

--' A batch R holds as a list
asList :: [a] -> [a]

data Dir = North | South | East

record Pt where
  x :: Real
  label :: Str
record Cpp => Pt = "struct"
record Py => Pt = "dict"
record Rust => Pt = "struct"
record R => Pt = "list"

data Shape = Dot | Circle Real | Box Pt

record Two where
  name :: Str
  tag :: U8
  xs :: [I16]
  more :: [Str]
record Cpp => Two = "struct"
record Py => Two = "dict"
record Rust => Two = "struct"
record R => Two = "list"

record Units where
  u :: ()
  s :: Str
  v :: ()
record Cpp => Units = "struct"
record Py => Units = "dict"
record Rust => Units = "struct"
record R => Units = "list"

data Tree = Leaf | Node Int Tree Tree

data Rose = Rose I32 [Rose]

-- A deep field before fields with tails: laid out in field order.
data Chain = End | Link Str Chain [I8] Str

drainC :: Int -> OStream a -> [[a]] -> <IO> ()
drainC z o xss = do
  ? length xss == 0 = do
      ()
  : do
    @write z o (idcpp (.0 (uncons xss)))
    drainC z o (.1 (uncons xss))

drainR :: Int -> OStream a -> [[a]] -> <IO> ()
drainR z o xss = do
  ? length xss == 0 = do
      ()
  : do
    @write z o (idrust (.0 (uncons xss)))
    drainR z o (.1 (uncons xss))

drainP :: Int -> OStream a -> [[a]] -> <IO> ()
drainP z o xss = do
  ? length xss == 0 = do
      ()
  : do
    @write z o (idpy (.0 (uncons xss)))
    drainP z o (.1 (uncons xss))

drainL :: Int -> OStream a -> [[a]] -> <IO> ()
drainL z o xss = do
  ? length xss == 0 = do
      ()
  : do
    @write z o (asList (.0 (uncons xss)))
    drainL z o (.1 (uncons xss))

drainV :: Int -> OStream a -> [[a]] -> <IO> ()
drainV z o xss = do
  ? length xss == 0 = do
      ()
  : do
    @write z o (idr (.0 (uncons xss)))
    drainV z o (.1 (uncons xss))

wcReal :: Int -> Str -> [[Real]] -> <IO> ()
wcReal z path xss = do
  Ok o <- @open path :: <IO> (Try Str (OStream Real))
  drainC z o xss
  @close o

wrReal :: Int -> Str -> [[Real]] -> <IO> ()
wrReal z path xss = do
  Ok o <- @open path :: <IO> (Try Str (OStream Real))
  drainR z o xss
  @close o

wpReal :: Int -> Str -> [[Real]] -> <IO> ()
wpReal z path xss = do
  Ok o <- @open path :: <IO> (Try Str (OStream Real))
  drainP z o xss
  @close o

