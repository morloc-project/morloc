wnBigOne :: Int -> Str -> [Int] -> <IO> ()
wnBigOne z path xs = do
  Ok o <- @open path :: <IO> (Try Str (OStream Int))
  @write z o xs
  @close o

wpBigOne :: Int -> Str -> [Int] -> <IO> ()
wpBigOne z path xs = do
  Ok o <- @open path :: <IO> (Try Str (OStream Int))
  @write z o (idpy xs)
  @close o

