-- Every value is written to a stream file in place by C++ and by Rust
-- (SLOT-36, SLOT-37) and from a voidstar copy by Python, which the runtime
-- lays out. All three write the same JSON batches, and each in-place file
-- must agree with Python's byte for byte, sub-packet cuts and footer
-- included, apart from the writer's pid and times (same.py). The types
-- cover alignment relative to the element's origin, empty arrays and
-- strings, size slack, records and data arms with deep fields before
-- fields with tails (Tree, Chain: laid out in field order), and a rose
-- tree 10000 deep. The 4096-byte buffer cuts most batches. A few types are
-- also written with the default buffer, and to standard output, which takes
-- the voidstar copy in every language (a staged stream); C++ and Rust size
-- that copy with the sizes they computed for the in-place attempt.
module main
  ( wcReal, wrReal, wpReal
  , wcI8, wrI8, wpI8
  , wcBool, wrBool, wpBool
  , wcPair, wrPair, wpPair
  , wcI64, wrI64, wpI64
  , wcInt, wrInt, wpInt
  , wcStr, wrStr, wpStr
  , wcReals, wrReals, wpReals
  , wcI8s, wrI8s, wpI8s
  , wcU8s, wrU8s, wpU8s
  , wcStrs3, wrStrs3, wpStrs3
  , wcOptStr, wrOptStr, wpOptStr
  , wcOptReals, wrOptReals, wpOptReals
  , wcOptI16s, wrOptI16s, wpOptI16s
  , wcDir, wrDir, wpDir
  , wcShape, wrShape, wpShape
  , wcTwo, wrTwo, wpTwo
  , wcMixed, wrMixed, wpMixed
  , wcTree, wrTree, wpTree
  , wcRose, wrRose, wpRose
  , wcChain, wrChain, wpChain
  , wcUnits, wrUnits, wpUnits
  , wcUnit, wrUnit, wpUnit
  , scStrs3, srStrs3, spStrs3
  , scTree, srTree, spTree
  , scMixed, srMixed, spMixed
  , scUnits, srUnits, spUnits
  , scChain, srChain, spChain
  , scRose, srRose, spRose
  , scShape, srShape, spShape
  , scOptReals, srOptReals, spOptReals
  , scU8s, srU8s, spU8s
  , scStr, srStr, spStr
  )


import root
import root-cpp
import root-py
import root-rust

data Dir = North | South | East

record Pt where
  x :: Real
  label :: Str
record Cpp => Pt = "struct"
record Py => Pt = "dict"
record Rust => Pt = "struct"

data Shape = Dot | Circle Real | Box Pt

record Two where
  name :: Str
  tag :: U8
  xs :: [I16]
  more :: [Str]
record Cpp => Two = "struct"
record Py => Two = "dict"
record Rust => Two = "struct"

record Units where
  u :: ()
  s :: Str
  v :: ()
record Cpp => Units = "struct"
record Py => Units = "dict"
record Rust => Units = "struct"

data Tree = Leaf | Node Int Tree Tree

data Rose = Rose I32 [Rose]

-- A deep field before fields with tails: laid out in field order.
data Chain = End | Link Str Chain [I8] Str

drainC :: Int -> OStream a -> [[a]] -> <IO> ()
drainC z o xss = do
  ? length xss == 0 = do
      ()
  : do
    @write z o (idcpp (.0 (uncons xss)))
    drainC z o (.1 (uncons xss))

drainR :: Int -> OStream a -> [[a]] -> <IO> ()
drainR z o xss = do
  ? length xss == 0 = do
      ()
  : do
    @write z o (idrust (.0 (uncons xss)))
    drainR z o (.1 (uncons xss))

drainP :: Int -> OStream a -> [[a]] -> <IO> ()
drainP z o xss = do
  ? length xss == 0 = do
      ()
  : do
    @write z o (idpy (.0 (uncons xss)))
    drainP z o (.1 (uncons xss))

wcReal :: Int -> Str -> [[Real]] -> <IO> ()
wcReal z path xss = do
  Ok o <- @open path :: <IO> (Try Str (OStream Real))
  drainC z o xss
  @close o

wrReal :: Int -> Str -> [[Real]] -> <IO> ()
wrReal z path xss = do
  Ok o <- @open path :: <IO> (Try Str (OStream Real))
  drainR z o xss
  @close o

wpReal :: Int -> Str -> [[Real]] -> <IO> ()
wpReal z path xss = do
  Ok o <- @open path :: <IO> (Try Str (OStream Real))
  drainP z o xss
  @close o

