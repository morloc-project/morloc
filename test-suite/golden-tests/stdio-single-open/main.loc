-- Uniqueness (CAS-per-kind) and refusal guards on stdio.
--
--   * `twoStdin`, `twoStdout`, `twoStderr` -- second open of the same
--     stdio kind hits the SHM claim CAS and errors.
--   * `reopenAfterClose` -- @close releases the claim, so a subsequent
--     open of the same kind succeeds.
--   * `allThreeAtOnce` -- the three claim slots are independent.
--   * `openDevStdout`, `openDevStderr` -- `@open` on `/dev/stdout` /
--     `/dev/stderr` is refused (a naive user would otherwise race the
--     nexus's own fd 1/2); use `@stdout` / `@stderr` instead.
--   * `openDevStdin` -- `/dev/stdin` is a supported input, not a refused
--     path: `@open :: IStream` routes to the stdin channel. In a pure
--     (nexus-evaluated) command like this one -- no language pool to read
--     stdin -- it errors cleanly instead.

module main
  ( twoStdin
  , twoStdout
  , twoStderr
  , reopenAfterClose
  , allThreeAtOnce
  , openDevStdin
  , openDevStdout
  , openDevStderr
  )

import root-py

twoStdin :: <IO> (IStream Int)
twoStdin = do
  @stdin :: <IO> (Try Str (IStream Int))
  Ok _tailv79 <- @stdin :: <IO> (Try Str (IStream Int))
  _tailv79

twoStdout :: <IO> (OStream Int)
twoStdout = do
  @stdout :: <IO> OStream Int
  @stdout :: <IO> OStream Int

twoStderr :: <IO> (OStream Int)
twoStderr = do
  @stderr :: <IO> OStream Int
  @stderr :: <IO> OStream Int

reopenAfterClose :: <IO> ()
reopenAfterClose = do
  Ok s1 <- @stdin :: <IO> (Try Str (IStream Int))
  @close s1
  Ok s2 <- @stdin :: <IO> (Try Str (IStream Int))
  @close s2

allThreeAtOnce :: <IO> ()
allThreeAtOnce = do
  Ok i <- @stdin :: <IO> (Try Str (IStream Int))
  o <- @stdout :: <IO> OStream Int
  e <- @stderr :: <IO> OStream Int
  @close i
  @close o
  @close e

openDevStdin :: <IO> (IStream Int)
openDevStdin = do
  Ok _rv <- @open "/dev/stdin" :: <IO> (Try Str (IStream Int))
  _rv

openDevStdout :: <IO> (OStream Int)
openDevStdout = do
  Ok _rv <- @open "/dev/stdout" :: <IO> (Try Str (OStream Int))
  _rv

openDevStderr :: <IO> (OStream Int)
openDevStderr = do
  Ok _rv <- @open "/dev/stderr" :: <IO> (Try Str (OStream Int))
  _rv
