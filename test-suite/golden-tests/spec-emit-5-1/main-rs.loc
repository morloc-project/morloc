nested :: Int -> Int
nested x = (? x < 100 = (? x < 100 = (? x < 100 = (? x < 100 = (? x < 100 = (? x < 100 = (? x < 100 = (? x < 100 = (? x < 100 = (? x < 100 = (? x < 100 = (? x < 100 = (? x < 100 = (? x < 100 = (? x < 100 = (? x < 100 = (? x < 100 = (? x < 100 = (? x < 100 = (? x < 100 = (? x < 100 = (? x < 100 = x : ? x == 101 = 1 : 0) : ? x == 102 = 2 : 0) : ? x == 103 = 3 : 0) : ? x == 104 = 4 : 0) : ? x == 105 = 5 : 0) : ? x == 106 = 6 : 0) : ? x == 107 = 7 : 0) : ? x == 108 = 8 : 0) : ? x == 109 = 9 : 0) : ? x == 110 = 10 : 0) : ? x == 111 = 11 : 0) : ? x == 112 = 12 : 0) : ? x == 113 = 13 : 0) : ? x == 114 = 14 : 0) : ? x == 115 = 15 : 0) : ? x == 116 = 16 : 0) : ? x == 117 = 17 : 0) : ? x == 118 = 18 : 0) : ? x == 119 = 19 : 0) : ? x == 120 = 20 : 0) : ? x == 121 = 21 : 0) : ? x == 122 = 22 : 0)
