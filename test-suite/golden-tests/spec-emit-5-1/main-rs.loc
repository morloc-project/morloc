countdown :: Int -> Int -> Int
countdown k acc
  ? k <= 0 = acc
  : ? k == 1 = countdown (k - 1) (acc + 1)
  : ? k == 2 = countdown (k - 1) (acc + 2)
  : ? k == 3 = countdown (k - 1) (acc + 3)
  : ? k == 4 = countdown (k - 1) (acc + 4)
  : ? k == 5 = (? acc > 1000 = acc : countdown (k - 1) (acc + 5))
  : ? k == 6 = countdown (k - 1) (acc + 6)
