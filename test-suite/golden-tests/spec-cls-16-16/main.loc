-- Spec CLS-16: an instance written over List itself, by a body or by a source,
-- is the one a bracket chain calls; the native list map does not stand in for it.
module main (run, direct)
import root

type Py => Int = "int"
type Py => I64 = "int"
type Py => (List a) = "list" a
type Py => (Optional a) = "Optional" a

record R where
  x :: Int
record Py => R = "dict"

source Py from "h.py" ("h_rev" as rev, "h_map" as mapList)
rev :: [a] -> [a]
mapList :: (a -> b) -> [a] -> [b]

instance Sliceable List where
  source Py from "h.py" ("h_slice" as __get_slice__)
instance IndexLike (?I64) where
  source Py from "h.py" ("h_id" as __to_index__)

instance Functor List where
  map f xs = mapList f (rev xs)

run :: [R] -> [Int]
run xs = .[:].x xs

direct :: [R] -> [Int]
direct xs = map (\r -> .x r) xs
