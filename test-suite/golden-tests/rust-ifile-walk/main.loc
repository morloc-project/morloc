-- Rust pool member: IFile pattern-access walker (@ifile_walk).
--
-- Bracket and field accessors applied to an open IFile lower to the
-- @ifile_walk intrinsic: the runtime seeks into the on-disk packet and
-- materialises only the requested slice/element, converting it to the
-- result type via the Rust FromVoidstar impls. `path` encodes the
-- walk-step chain; the runtime bracket bounds are passed as optional
-- ints (the Option<i64> args the Rust bridge packs into IFileWalkArg).
--
-- Coverage:
--   * .[i]    on [Int]  (fixed-width element)
--   * .[i]    on [Str]  (variable-width element)
--   * .[i:j]  on [Int]  (bounded slice)
--   * .[i:]   on [Int]  (open-ended slice -> absent upper bound = None arg)
--   * .field  on a record (struct field select through the IFile)
--   * the same accessors inside a Rust pool (the do-block calls a Rust
--     function, so the walk is emitted as Rust code rather than run by
--     the nexus): .[i] with a literal and a variable index, .[i].field
--     on a list of records
--
-- Rust because it imports root-rust; the spec is backend-agnostic.

module main
  ( testIntIndex
  , testStrIndex
  , testIntSlice
  , testIntTail
  , testRecordField
  , testIndexInPool
  , testVarIndexInPool
  , testIndexFieldInPool
  )

import root-rust

source Rust from "impl.rs" ("plus", "str_len" as strLen)
plus :: Int -> Int -> Int
strLen :: Str -> Int

record Point where
  x :: Int
  y :: Int
record Rust => Point = "struct"

mkPoint :: Int -> Int -> Point
mkPoint a b = {x = a, y = b}

-- .[i] on a fixed-width element list.
testIntIndex :: Str -> <IO> Int
testIntIndex path = do
  @save 0 path [10, 20, 30, 40, 50]
  Ok f <- @open path :: <IO> (Try Str (IFile [Int]))
  .[2] f                                       -- expect 30

-- .[i] on a variable-width element list.
testStrIndex :: Str -> <IO> Str
testStrIndex path = do
  @save 0 path ["alpha", "beta", "gamma", "delta"]
  Ok f <- @open path :: <IO> (Try Str (IFile [Str]))
  .[2] f                                       -- expect "gamma"

-- .[i:j] bounded slice.
testIntSlice :: Str -> <IO> [Int]
testIntSlice path = do
  @save 0 path [10, 20, 30, 40, 50]
  Ok f <- @open path :: <IO> (Try Str (IFile [Int]))
  .[1:4] f                                      -- expect [20, 30, 40]

-- .[i:] open-ended slice (absent upper bound -> a None walk arg).
testIntTail :: Str -> <IO> [Int]
testIntTail path = do
  @save 0 path [10, 20, 30, 40, 50]
  Ok f <- @open path :: <IO> (Try Str (IFile [Int]))
  .[3:] f                                       -- expect [40, 50]

-- Field select on a record through the IFile.
testRecordField :: Str -> <IO> Int
testRecordField path = do
  @save 0 path (mkPoint 7 9)
  Ok f <- @open path :: <IO> (Try Str (IFile Point))
  .y f                                          -- expect 9

-- .[i] inside a Rust pool.
testIndexInPool :: Str -> <IO> Int
testIndexInPool path = do
  @save 0 path ["alpha", "beta", "gamma"]
  Ok f <- @open path :: <IO> (Try Str (IFile [Str]))
  strLen (.[1] f)                               -- expect 4

-- .[i] with a variable index inside a Rust pool.
testVarIndexInPool :: Str -> <IO> Int
testVarIndexInPool path = do
  @save 0 path [10, 20, 30, 40, 50]
  Ok f <- @open path :: <IO> (Try Str (IFile [Int]))
  let i = plus 1 2
  plus 0 (.[i] f)                               -- expect 40

-- .[i].field on a list of records inside a Rust pool.
testIndexFieldInPool :: Str -> <IO> Int
testIndexFieldInPool path = do
  @save 0 path [mkPoint 1 2, mkPoint 3 4]
  Ok f <- @open path :: <IO> (Try Str (IFile [Point]))
  plus 0 (.[1].y f)                             -- expect 4
