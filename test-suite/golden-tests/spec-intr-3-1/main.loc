-- A saved file loads only at the type it was saved with (INTR-3),
-- uncompressed and compressed, through @load and as a command-line
-- argument file: each wrong-type load is an Err (or a refused argument)
-- and each right-type load gives the saved values back.

module main (save0, save3, loadInts, loadReals, sumInts, sumReals)

import root-py

save0 :: Str -> [Int] -> <IO> (Try Str ())
save0 p xs = @save 0 p xs

save3 :: Str -> [Int] -> <IO> (Try Str ())
save3 p xs = @save 3 p xs

loadInts :: Str -> <IO> (Try Str [Int])
loadInts p = @load p

loadReals :: Str -> <IO> (Try Str [Real])
loadReals p = @load p

sumInts :: [Int] -> Int
sumInts xs = fold (+) 0 xs

sumReals :: [Real] -> Real
sumReals xs = fold (+) 0.0 xs
