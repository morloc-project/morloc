-- @save / @load round-trip executed entirely inside the nexus, with
-- no language pool involved. This exercises the path that previously
-- aborted with `free(): invalid size` -- mlc_load returns SHM-allocated
-- memory but the eval handler called libc::free on it. The Python-pool
-- variant in intrinsic-load-tail-position does not cover this case
-- because routing the value through `identity :: a -> a` from helper.py
-- forces a pool round-trip that masks the bug.
--
-- Each case exercises a different shape in voidstar::deep_copy, the
-- helper that converts mlc_load's single-block payload into the
-- multi-block layout the rest of the evaluator uses:
--   * Int  -- primitive (wrapper IS the data)
--   * Real -- primitive (F64)
--   * Str  -- Array<u8>: wrapper + separate char block
--   * [Str] -- nested Array<Array<u8>>: variable-width elements
--   * (Int, Str) -- Tuple with mixed fixed and variable elements
--   * [(Int, Real)] -- Array of fixed-width Tuple (bulk-copy path)
-- across the three save formats (binary voidstar, msgpack, json).
--
-- @load and @save both raise Err on failure now; the round-trip
-- signatures declare `<IO>` so that propagates. The missing-file
-- case is exercised via @catch to demonstrate the fallback pattern.

module main

  ( binInt
  , msgInt
  , jsonInt
  , binReal
  , msgReal
  , jsonReal
  , binStr
  , msgStr
  , jsonStr
  , binList
  , msgList
  , jsonList
  , binTup
  , msgTup
  , jsonTup
  , binFixedTupList
  , msgFixedTupList
  , jsonFixedTupList
  , loadMissing
  )

-- `Try` is declared in `internal` and reaches user code through `root`;
-- a fallible intrinsic or `@try` needs it in scope.
import root

effect IO
effect Err

binInt :: Int -> Str -> <IO> Int
binInt x path = do
  @save 0 path x
  Ok _tailv45 <- @load path
  _tailv45

msgInt :: Int -> Str -> <IO> Int
msgInt x path = do
  @savem path x
  Ok _tailv46 <- @load path
  _tailv46

jsonInt :: Int -> Str -> <IO> Int
jsonInt x path = do
  @savej path x
  Ok _tailv47 <- @load path
  _tailv47

binReal :: Real -> Str -> <IO> Real
binReal x path = do
  @save 0 path x
  Ok _tailv48 <- @load path
  _tailv48

msgReal :: Real -> Str -> <IO> Real
msgReal x path = do
  @savem path x
  Ok _tailv49 <- @load path
  _tailv49

jsonReal :: Real -> Str -> <IO> Real
jsonReal x path = do
  @savej path x
  Ok _tailv50 <- @load path
  _tailv50

binStr :: Str -> Str -> <IO> Str
binStr s path = do
  @save 0 path s
  Ok _tailv51 <- @load path
  _tailv51

msgStr :: Str -> Str -> <IO> Str
msgStr s path = do
  @savem path s
  Ok _tailv52 <- @load path
  _tailv52

jsonStr :: Str -> Str -> <IO> Str
jsonStr s path = do
  @savej path s
  Ok _tailv53 <- @load path
  _tailv53

binList :: [Str] -> Str -> <IO> [Str]
binList xs path = do
  @save 0 path xs
  Ok _tailv54 <- @load path
  _tailv54

msgList :: [Str] -> Str -> <IO> [Str]
msgList xs path = do
  @savem path xs
  Ok _tailv55 <- @load path
  _tailv55

jsonList :: [Str] -> Str -> <IO> [Str]
jsonList xs path = do
  @savej path xs
  Ok _tailv56 <- @load path
  _tailv56

binTup :: (Int, Str) -> Str -> <IO> (Int, Str)
binTup t path = do
  @save 0 path t
  Ok _tailv57 <- @load path
  _tailv57

msgTup :: (Int, Str) -> Str -> <IO> (Int, Str)
msgTup t path = do
  @savem path t
  Ok _tailv58 <- @load path
  _tailv58

jsonTup :: (Int, Str) -> Str -> <IO> (Int, Str)
jsonTup t path = do
  @savej path t
  Ok _tailv59 <- @load path
  _tailv59

binFixedTupList :: [(Int, Real)] -> Str -> <IO> [(Int, Real)]
binFixedTupList xs path = do
  @save 0 path xs
  Ok _tailv60 <- @load path
  _tailv60

msgFixedTupList :: [(Int, Real)] -> Str -> <IO> [(Int, Real)]
msgFixedTupList xs path = do
  @savem path xs
  Ok _tailv61 <- @load path
  _tailv61

jsonFixedTupList :: [(Int, Real)] -> Str -> <IO> [(Int, Real)]
jsonFixedTupList xs path = do
  @savej path xs
  Ok _tailv62 <- @load path
  _tailv62

-- @load on a missing file raises Err; @catch intercepts and substitutes
-- the sentinel (-1) so the caller sees a well-defined value.
loadMissing :: Str -> <IO> Int
loadMissing path = do
  _mr <- @load path :: <IO> (Try Str (Int))
  match _mr | (Ok _cv) = _cv | (Err _) = (-1)
