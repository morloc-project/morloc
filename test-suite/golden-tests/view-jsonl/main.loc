-- Produces test corpora for the `morloc-nexus view -f jsonl` golden.
-- Each function takes an output path and materialises a data packet
-- via @save; the Makefile then runs `view -f jsonl` and checks the
-- shape of the output.

module main
  ( mkListInt
  , mkListRecord
  , mkScalar
  , mkEmpty
  )

import root

record Person where
  name :: Str
  age :: Int
record Py => Person = "dict"

mkListInt :: Str -> <IO> ()
mkListInt path = do
  Ok _rv <- @save 0 path [10, 20, 30, 40, 50]
  _rv

mkListRecord :: Str -> <IO> ()
mkListRecord path = do
  let _payload = [ {name = "Alice", age = 30}
    , {name = "Bob",   age = 25}
    , {name = "Carol", age = 40}
    ]
  @save 0 path _payload
  ()

mkScalar :: Str -> <IO> ()
mkScalar path = do
  Ok _rv <- @save 0 path 42
  _rv

mkEmpty :: Str -> <IO> ()
mkEmpty path = do
  Ok _rv <- @save 0 path ([] :: [Int])
  _rv
