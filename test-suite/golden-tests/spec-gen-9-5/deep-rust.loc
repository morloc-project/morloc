-- A record nested in itself more deeply than code generation expands is
-- refused in Rust with a message saying so.
module main (trip)

import root-rust

record Container a where
  val :: a
  sub :: ?(Container a)

source Rust from "c.rs" ("same")
same :: a -> a

trip :: Container (Container (Container (Container (Container (Container (Container (Int))))))) -> Container (Container (Container (Container (Container (Container (Container (Int)))))))
trip x = same x
