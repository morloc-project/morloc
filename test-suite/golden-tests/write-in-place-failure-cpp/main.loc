-- A C++ batch whose encoding fails partway (an element that is not UTF-8,
-- BASE-5) is absent from the file, whether it failed in its first
-- sub-packet or after filling several, and the stream takes later batches
-- (SLOT-36, SLOT-37). The error reaches the caller as a Try.
module main (run, tally)

import root
import root-cpp

source Cpp from "batch.hpp" ("batchOf", "countTagged")

batchOf :: Int -> Int -> Int -> [Str]
countTagged :: Int -> [Str] -> Int

--' Write five batches, two of which fail; report the failures
run :: Str -> <IO> [Bool]
run path = do
  Ok o <- @open path :: <IO> (Try Str (OStream Str))
  a <- @write 0 o (batchOf 1 700 (-1))
  b <- @write 0 o (batchOf 2 700 650)
  c <- @write 0 o (batchOf 3 30 (-1))
  d <- @write 0 o (batchOf 4 700 0)
  e <- @write 0 o (batchOf 5 700 (-1))
  @close o
  [ok a, ok b, ok c, ok d, ok e]

ok :: Try Str () -> Bool
ok r = match r
  | (Ok _) = True
  | (Err _) = False

--' Count the elements of each batch in a written file
tally :: [Str] -> [Int]
tally xs = [countTagged 1 xs, countTagged 2 xs, countTagged 3 xs, countTagged 4 xs, countTagged 5 xs, length xs]
