module (*)

import .harness
import root-r

record R => Holder = "list"
record R => Caller = "list"
record R => Purer = "list"

source R from "hosts.R"
  ( "home_tick" as tickHome
  , "home_ident" as identHome
  , "home_mark" as markHome
  , "home_str_len" as lenHome
  , "home_add" as addHome
  , "home_fail" as failHome
  , "home_big" as bigHome
  , "home_use_pure" as usePureHome
  , "home_take_thunk" as takeThunkHome
  )

-- a curried host: `mk(k)` returns a callable, so the call is `mk(k)(x)`
source R from "hosts.R" where
  --' name: home_mk
  --' @rsize 1
  mkHome
