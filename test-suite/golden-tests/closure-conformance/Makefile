PROGRAMS = local-py home-cpp away-cpp local-cpp home-r away-r local-r home-rust away-rust local-rust

all:
	: > obs.txt
	rm -f *.err cnt-*
	echo "--- local-py ---" >> obs.txt
	morloc make -o local-py main-local-py.loc 2>> build.err || echo "BUILD FAILED" >> obs.txt
	[ -x local-py ] && ./local-py test $$PWD/cnt-local-py >> obs.txt 2>> obs.err || true
	echo "--- home-cpp ---" >> obs.txt
	morloc make -o home-cpp main-home-cpp.loc 2>> build.err || echo "BUILD FAILED" >> obs.txt
	[ -x home-cpp ] && ./home-cpp test $$PWD/cnt-home-cpp >> obs.txt 2>> obs.err || true
	echo "--- away-cpp ---" >> obs.txt
	morloc make -o away-cpp main-away-cpp.loc 2>> build.err || echo "BUILD FAILED" >> obs.txt
	[ -x away-cpp ] && ./away-cpp test $$PWD/cnt-away-cpp >> obs.txt 2>> obs.err || true
	echo "--- local-cpp ---" >> obs.txt
	morloc make -o local-cpp main-local-cpp.loc 2>> build.err || echo "BUILD FAILED" >> obs.txt
	[ -x local-cpp ] && ./local-cpp test $$PWD/cnt-local-cpp >> obs.txt 2>> obs.err || true
	echo "--- home-r ---" >> obs.txt
	morloc make -o home-r main-home-r.loc 2>> build.err || echo "BUILD FAILED" >> obs.txt
	[ -x home-r ] && ./home-r test $$PWD/cnt-home-r >> obs.txt 2>> obs.err || true
	echo "--- away-r ---" >> obs.txt
	morloc make -o away-r main-away-r.loc 2>> build.err || echo "BUILD FAILED" >> obs.txt
	[ -x away-r ] && ./away-r test $$PWD/cnt-away-r >> obs.txt 2>> obs.err || true
	echo "--- local-r ---" >> obs.txt
	morloc make -o local-r main-local-r.loc 2>> build.err || echo "BUILD FAILED" >> obs.txt
	[ -x local-r ] && ./local-r test $$PWD/cnt-local-r >> obs.txt 2>> obs.err || true
	echo "--- home-rust ---" >> obs.txt
	morloc make -o home-rust main-home-rust.loc 2>> build.err || echo "BUILD FAILED" >> obs.txt
	[ -x home-rust ] && ./home-rust test $$PWD/cnt-home-rust >> obs.txt 2>> obs.err || true
	echo "--- away-rust ---" >> obs.txt
	morloc make -o away-rust main-away-rust.loc 2>> build.err || echo "BUILD FAILED" >> obs.txt
	[ -x away-rust ] && ./away-rust test $$PWD/cnt-away-rust >> obs.txt 2>> obs.err || true
	echo "--- local-rust ---" >> obs.txt
	morloc make -o local-rust main-local-rust.loc 2>> build.err || echo "BUILD FAILED" >> obs.txt
	[ -x local-rust ] && ./local-rust test $$PWD/cnt-local-rust >> obs.txt 2>> obs.err || true

