-- A conditional whose arms are effectful, in a Rust pool.
--
-- A deferred effect is carried as a nullary thunk, so a conditional over two of
-- them yields a thunk and its binding must be typed as one. Covered here: a
-- guard returning a value, one returning unit, one whose arms are do blocks,
-- and one nested inside another, none of them recursive -- the tail-recursive
-- form is lowered as a loop and takes a different path.

module main (pick, pickUnit, pickDo, pickNested, forcedTwice)

import root-rust

source Rust from "own.rs"
  ( "re_emit" as emit
  , "re_nop" as nop
  , "re_tick" as tick
  )

emit :: Int -> <IO> Int
nop :: <IO> ()
tick :: Str -> <IO> Int

pick :: Bool -> <IO> Int
pick b
  ? b = emit 1
  : emit 2

pickUnit :: Bool -> <IO> ()
pickUnit b
  ? b = nop
  : nop

pickDo :: Bool -> <IO> Int
pickDo b
  ? b = do
      x <- emit 3
      emit x
  : do
      y <- emit 4
      emit y

pickNested :: Bool -> Bool -> <IO> Int
pickNested b c
  ? b = pick c
  : emit 9

-- The conditional yields a SUSPENSION, so choosing an arm must not run it.
-- Bound once and forced three times, the effect must happen exactly three
-- times: once per force, not once per arm and not once per condition test.
-- The cases above check only values, which cannot see a change in how often
-- an arm runs.
pickTick :: Str -> Bool -> <IO> Int
pickTick p b
  ? b = tick p
  : tick p

forcedTwice :: Str -> Bool -> <IO> Int
forcedTwice p b = do
  let t = pickTick p b
  _ <- t
  _ <- t
  t
