-- A bracket on a receiver that is not a list on the wire reaches it only
-- through its instance, which runs in a pool (PAT-5). The nexus evaluator
-- brackets lists natively and must refuse anything else rather than read
-- the receiver as a list.

module main (first)

import root-py

newtype Two a = (a, a)

instance Indexable Two where
  source Py from "two.py" ("at" as __access_index__)

first :: Two Int -> Int
first p = .[0] p
