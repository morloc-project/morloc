-- The Python form of main.loc: a streamed render whose handler returns
-- `[Str]` or `[[U8]]` writes each batch's pieces in order with nothing added.
module main (pieces, bytes)

import root-py

source Py from "impl.py"
  ( "mk"
  , "render_pieces" as renderPieces
  , "render_byte_pieces" as renderBytePieces
  )

--' Batch n: the n numbers 10n to 10n+n-1
mk :: Int -> [Int]
--' A batch as text pieces, ending in a newline; none for an empty batch
renderPieces :: [Int] -> [Str]
--' A batch as byte pieces, ending in a newline; none for an empty batch
renderBytePieces :: [Int] -> [[U8]]

--' Send batches 2, 0 and 3 to a sink
produce :: ([Int] -> <IO> ()) -> <IO> ()
produce sink = do
  _ <- sink (mk 2)
  _ <- sink (mk 0)
  sink (mk 3)

--' Stream each batch as text pieces
--' @render -t/--text=renderPieces @stream @default
--' @render -w/--whole=renderPieces
pieces :: Int -> <IO> (Collect Int)
pieces n = @collect produce

--' Stream each batch as byte pieces
--' @render -b/--bytes=renderBytePieces @stream @default
--' @render -w/--whole=renderBytePieces
bytes :: Int -> <IO> (Collect Int)
bytes n = @collect produce
