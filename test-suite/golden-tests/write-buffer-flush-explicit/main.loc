-- @flush between @writes produces distinct sub-packets.
-- Two @writes + @flush in between yields TWO sub-packets,
-- not one coalesced one. The reader's first @next sees the
-- first batch, the second @next sees the second batch.
--
-- This is the test that proves @flush actually flushes (rather
-- than being a no-op that gets coalesced anyway).

module main
  ( testFlushFirst
  , testFlushSecond
  , testFlushThird
  , testFlushEof
  )

import root

writeWithFlushes :: Str -> <IO> ()
writeWithFlushes path = do
  Ok o <- @open path :: <IO> (Try Str (OStream Int))
  @write 0 o [10, 20, 30]
  @flush o
  @write 0 o [40, 50]
  @flush o
  @write 0 o [60, 70, 80, 90]
  @close o

testFlushFirst :: Str -> <IO> [Int]
testFlushFirst path = do
  writeWithFlushes path
  Ok s <- @open path :: <IO> (Try Str (IStream Int))
  Ok _tailv69 <- @next s
  _tailv69

testFlushSecond :: Str -> <IO> [Int]
testFlushSecond path = do
  writeWithFlushes path
  Ok s <- @open path :: <IO> (Try Str (IStream Int))
  @next s
  Ok _tailv70 <- @next s
  _tailv70

testFlushThird :: Str -> <IO> [Int]
testFlushThird path = do
  writeWithFlushes path
  Ok s <- @open path :: <IO> (Try Str (IStream Int))
  @next s
  @next s
  Ok _tailv71 <- @next s
  _tailv71

testFlushEof :: Str -> <IO> [Int]
testFlushEof path = do
  writeWithFlushes path
  Ok s <- @open path :: <IO> (Try Str (IStream Int))
  @next s
  @next s
  @next s
  Ok _tailv72 <- @next s
  _tailv72
