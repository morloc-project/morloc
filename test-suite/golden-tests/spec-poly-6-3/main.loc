-- Spec POLY-6: a variable no native representation needs is not an error.
-- The parameter of the argument-free `Tag` is never determined, and a
-- `Tag a` value is a one-byte constructor tag in every language.
module main (f)

import root-py

data Tag a = A | B

count :: Tag a -> Int
count | A = 1
      | B = 2

f :: Int -> Int
f x = count A
