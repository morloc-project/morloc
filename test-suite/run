#!/usr/bin/env bash
# run - the one entry point to every morloc test, check and benchmark.
#
#   test-suite/run [options] SUITE... [-- EXTRA_ARGS]
#   test-suite/run list            every suite, what it runs, what it needs
#
# Options:
#   --shard I/N   run the I-th of N golden shards (units run only in shard 1)
#   -j N          tasty worker count for the Haskell suites
#   -p PATTERN    tasty pattern for the Haskell suites
#   --long        long sizing for the shell suites (minutes; for hunting races)
#   --ci          the environment continuous integration runs with: poisoned
#                 released shared memory, cargo in its own session, required
#                 namespaces on Linux, CI's recursion-depth languages
# EXTRA_ARGS go to the underlying runner (tasty, cargo, or the suite script).
#
# Golden tests can be narrowed by group: `run golden/spec/gen`, `run golden/cli`.
#
# STACK_ARGS (environment) is passed to every stack call, e.g.
# STACK_ARGS="--system-ghc --no-install-ghc" in CI.
#
# Runs from any directory. Exits nonzero if any suite failed. It does not
# limit its own memory; wrap it where the machine needs that.

set -uo pipefail

TS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$TS/.." && pwd)"
SUITES="$TS/integration/suites"
cd "$ROOT"

# macOS ships no timeout(1); the suites bound their runs with it.
if ! command -v timeout > /dev/null 2>&1; then
    export PATH="$TS/tools/shims:$PATH"
fi

if [[ -t 1 ]]; then
    GREEN=$'\033[32m' RED=$'\033[31m' BOLD=$'\033[1m' RESET=$'\033[0m'
else
    GREEN='' RED='' BOLD='' RESET=''
fi

# name|what it runs|needs|cost|ci
# A table rather than an associative array: macOS ships bash 3.2.
CATALOG='
setup|stack install, then morloc init -f from this tree|stack, cargo|5-15 min|
unit|Haskell unit tests (morloc-test, units only)|stack|2-5 min|shard 1
golden|golden programs (morloc-test, goldens only); golden/GROUP narrows|setup|30-60 min|every shard
spec|every spec-* unit and golden test, and model/check.sh|setup|15 min|
haskell|unit + golden (stack test morloc:morloc-test)|setup|30-60 min|every shard
integration|Haskell integration exe (morloc-integration-test)|setup|10-45 min|release
rust|cargo test over runtime and the Rust binding|libmorloc (setup)|5-8 min|shard 1
model|spec format and test citations (model/check.sh)|python3|seconds|in unit
tla|TLA+ models (model/runtime/tla/check.sh)|java 11+|10 min|
lint|portability lint of shell and make files|python3|seconds|shard 1
typecheck-bench|typecheck stress programs under a time limit (perf typechecking --check)|setup|1 min|shard 1
concurrency|bidirectional callbacks between pools|setup|1 min|shard 1
daemon|nexus daemon, router, HTTP/TCP/socket, SHM leaks|setup|1-2 min|shard 1
packet-io|packet round trips across volumes and pools|setup|1 min|shard 1
expose|package.yaml expose: install and consume|setup|1 min|shard 1
runtime-install|runtime/install.sh into scratch prefixes|cargo|1-3 min|shard 1
recursion-depth|recursion depth in every pool language|setup|1 min|shard 1 (Linux)
stress|zombies, SHM and temp leaks under repeated runs|setup|minutes|
mcp|the nexus MCP server, all groups|setup, python3|minutes|
errors|deliberately broken programs fail cleanly|setup|2 min|
manager|mim serving path|mim, docker or podman|minutes|
perf|performance model benchmarks (model/performance)|setup, quiet machine|1 hour|
quick|model lint unit|||
ci|what CI runs: shard 1 runs rust lint typecheck-bench concurrency daemon packet-io expose runtime-install recursion-depth, then every shard runs haskell|||
all|every suite except setup tla perf manager|||
'

usage() { sed -n '2,24p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

list_suites() {
    printf '%-16s %-14s %-14s %s\n' SUITE COST CI RUNS
    echo "$CATALOG" | while IFS='|' read -r name what needs cost ci; do
        [[ -z "$name" ]] && continue
        printf '%-16s %-14s %-14s %s' "$name" "${cost:--}" "${ci:--}" "$what"
        [[ -n "$needs" ]] && printf ' [needs: %s]' "$needs"
        printf '\n'
    done
}

known() { echo "$CATALOG" | cut -d'|' -f1 | grep -qx "$1"; }

SHARD="" JOBS="" PATTERN="" CI=0 EXTRA=()
export MORLOC_TEST_LEVEL="${MORLOC_TEST_LEVEL:-short}"
selected=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --shard) SHARD="$2"; shift 2 ;;
        -j) JOBS="$2"; shift 2 ;;
        -p) PATTERN="$2"; shift 2 ;;
        --long) export MORLOC_TEST_LEVEL=long; shift ;;
        --short) export MORLOC_TEST_LEVEL=short; shift ;;
        --ci) CI=1; shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; EXTRA=("$@"); break ;;
        *) selected+=("$1"); shift ;;
    esac
done
[[ ${#selected[@]} -eq 0 ]] && { usage; exit 2; }
[[ -n "$SHARD" ]] && export MORLOC_TEST_SHARD="$SHARD"
shard_index="${SHARD%%/*}"
read -r -a STACK <<< "${STACK_ARGS:-}"

linux() { [[ "$(uname -s)" == Linux ]]; }

# Build a Haskell test suite and run its executable directly from the repo
# root. `stack test --ta` splits its argument itself and passes quotes
# through literally, so a tasty pattern with spaces, quotes or `$` cannot
# reach the test program that way.
#   haskell_suite SUITE PATTERN
haskell_suite() {
    local exe="$1" pat="$2" args=()
    stack build ${STACK[@]+"${STACK[@]}"} --test --no-run-tests "morloc:$exe" || return 1
    local bin
    bin="$(stack path ${STACK[@]+"${STACK[@]}"} --dist-dir)/build/$exe/$exe"
    [[ -x "$bin" ]] || { echo "no test executable at $bin"; return 1; }
    [[ -n "$JOBS" ]] && args+=(-j "$JOBS")
    if [[ -n "$pat" && -n "$PATTERN" ]]; then
        args+=(-p "($pat) && ($PATTERN)")
    elif [[ -n "$pat" ]]; then
        args+=(-p "$pat")
    elif [[ -n "$PATTERN" ]]; then
        args+=(-p "$PATTERN")
    fi
    "$bin" ${args[@]+"${args[@]}"} ${EXTRA[@]+"${EXTRA[@]}"}
}

morloc_test() { MORLOC_TEST_SELECT="$1" haskell_suite morloc-test "$2"; }

# MORLOC_SHM_POISON fills released shared memory with a marker byte, so a
# read of freed memory shows garbage rather than plausible zeros.
runtime_env() {
    if [[ $CI -eq 1 ]]; then
        MORLOC_SHM_POISON=1 "$@"
    else
        "$@"
    fi
}

# Under --ci, run a command in a session of its own, so a test that signals
# its process group by mistake fails visibly instead of killing the runner;
# the fork tests need user namespaces on Linux.
in_session() {
    if [[ $CI -eq 1 ]]; then
        local ns=""
        linux && ns=1
        MORLOC_REQUIRE_NAMESPACES="$ns" perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV or die "exec: $!"' "$@"
    else
        "$@"
    fi
}

suite() {
    local name="$1"
    case "$name" in
        setup)
            stack install ${STACK[@]+"${STACK[@]}"} --no-run-tests &&
                MORLOC_RUNTIME_DIR="$ROOT/runtime" morloc init -f ;;
        unit) morloc_test unit "" ;;
        golden) morloc_test golden "" ;;
        golden/*)
            # tasty's path fields: $1 "Morloc tests", $2 "golden", then the groups.
            # A field test, since tasty's $0 ~ /.../ matches nothing.
            local path="${name#golden/}" pat='$2 == "golden"' n=3 part
            path="${path%/}"
            local IFS=/
            for part in $path; do
                pat="$pat && \$$n == \"$part\""
                n=$((n + 1))
            done
            unset IFS
            morloc_test golden "$pat" ;;
        spec) morloc_test all '/spec-/ || $2 == "spec"' && bash model/check.sh ;;
        haskell) morloc_test all "" ;;
        integration) haskell_suite morloc-integration-test "" ;;
        rust)
            # PANIC-9: the classifier tests reproduce a pool build only with a
            # pool's default release profile and flags (rustPoolRustflags).
            local pool_flags="-Zmerge-functions=disabled" pool_config=()
            if ! linux; then
                pool_flags="$pool_flags -Clink-arg=-Wl,-no_deduplicate"
                pool_config=(--config 'profile.release.split-debuginfo="packed"')
            fi
            # Extra arguments go to the runtime workspace run only.
            in_session cargo test --workspace --manifest-path runtime/Cargo.toml ${EXTRA[@]+"${EXTRA[@]}"} &&
                in_session cargo test --locked --manifest-path binders/rust/rustmorloc/Cargo.toml \
                    --target-dir runtime/target &&
                RUSTC_BOOTSTRAP=1 RUSTFLAGS="$pool_flags" \
                    in_session cargo test --locked --release --manifest-path binders/rust/rustmorloc/Cargo.toml \
                    --target-dir runtime/target --config 'profile.release.opt-level=2' \
                    --config 'profile.release.lto="thin"' --config 'profile.release.panic="unwind"' \
                    --config 'profile.release.debug="line-tables-only"' ${pool_config[@]+"${pool_config[@]}"} \
                    -- panic_classifier ;;
        model) bash model/check.sh ;;
        tla) bash model/runtime/tla/check.sh ${EXTRA[@]+"${EXTRA[@]}"} ;;
        lint) python3 "$TS/tools/portability-lint.py" ;;
        typecheck-bench) runtime_env python3 "$ROOT/model/performance/benchmarks/perf.py" typechecking --check ;;
        concurrency) runtime_env "$SUITES/concurrency/run-tests.sh" ${EXTRA[@]+"${EXTRA[@]}"} ;;
        daemon) runtime_env "$SUITES/daemon/run-tests.sh" ${EXTRA[@]+"${EXTRA[@]}"} ;;
        packet-io) runtime_env "$SUITES/packet-io/run-all.sh" ${EXTRA[@]+"${EXTRA[@]}"} ;;
        expose) runtime_env "$SUITES/expose/run-tests.sh" ${EXTRA[@]+"${EXTRA[@]}"} ;;
        runtime-install) "$SUITES/runtime-install/run-tests.sh" ;;
        recursion-depth)
            if [[ $CI -eq 1 ]]; then
                MORLOC_STRESS_LANGS="${MORLOC_STRESS_LANGS:-py cpp rust}" "$SUITES/stress/deep-recursion.sh"
            else
                "$SUITES/stress/deep-recursion.sh"
            fi ;;
        stress) "$SUITES/stress/run-all.sh" ${EXTRA[@]+"${EXTRA[@]}"} ;;
        mcp) "$SUITES/mcp/run-tests.sh" ${EXTRA[@]+"${EXTRA[@]}"} ;;
        errors) "$SUITES/errors/run-tests.sh" ${EXTRA[@]+"${EXTRA[@]}"} ;;
        manager) "$SUITES/manager/run-tests.sh" ${EXTRA[@]+"${EXTRA[@]}"} ;;
        perf) bash model/performance/benchmarks/run.sh ${EXTRA[@]+"${EXTRA[@]}"} ;;
        *) return 127 ;;
    esac
}

# expand tiers into suites
expand() {
    case "$1" in
        quick) echo model lint unit ;;
        ci)
            if [[ -z "$shard_index" || "$shard_index" == 1 ]]; then
                echo rust lint typecheck-bench concurrency daemon packet-io expose runtime-install
                linux && echo recursion-depth
            fi
            echo haskell ;;
        all) echo model lint rust haskell integration typecheck-bench concurrency daemon packet-io \
                  expose runtime-install recursion-depth stress mcp errors ;;
        *) echo "$1" ;;
    esac
}

if [[ "${selected[0]}" == list ]]; then
    list_suites
    exit 0
fi

plan=()
for s in ${selected[@]+"${selected[@]}"}; do
    for x in $(expand "$s"); do plan+=("$x"); done
done

PASSED=() FAILED=() UNKNOWN=()
for name in ${plan[@]+"${plan[@]}"}; do
    base="${name%%/*}"
    if ! known "$base"; then
        echo "${RED}unknown suite: $name${RESET} (see: test-suite/run list)"
        UNKNOWN+=("$name")
        continue
    fi
    printf '\n%s========== %s ==========%s\n' "$BOLD" "$name" "$RESET"
    start=$SECONDS
    if suite "$name"; then
        PASSED+=("$name ($((SECONDS - start))s)")
    else
        FAILED+=("$name ($((SECONDS - start))s)")
    fi
done

printf '\n%s===== summary =====%s\n' "$BOLD" "$RESET"
printf '  %spassed%s: %s\n' "$GREEN" "$RESET" "${PASSED[*]:-(none)}"
printf '  %sfailed%s: %s\n' "$RED" "$RESET" "${FAILED[*]:-(none)}"
[[ ${#UNKNOWN[@]} -gt 0 ]] && printf '  unknown: %s\n' "${UNKNOWN[*]}"
[[ ${#FAILED[@]} -eq 0 && ${#UNKNOWN[@]} -eq 0 ]]
