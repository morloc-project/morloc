module main (pyPy, pyCpp, pyR, pyRs, cppPy, cppCpp, cppR, cppRs, rPy, rCpp, rR, rRs, rsPy, rsCpp, rsR, rsRs, nativePy, nativeCpp, nativeR, nativeRs,
             pyCppRec, cppPyRec, pyCppVec, cppPyVec)

import root-py
import root-cpp
import root-r
import root-rust

source Py from "f.py" ("inc" as incPy, "mapf" as mapPy, "native" as nativePy)
source Cpp from "f.hpp" ("inc" as incCpp, "mapf" as mapCpp, "native" as nativeCpp)
source R from "f.R" ("inc" as incR, "mapf" as mapR, "native" as nativeR)
source Rust from "f.rs" ("inc" as incRs, "mapf" as mapRs, "native" as nativeRs)

incPy :: I64 -> I64
mapPy :: (I64 -> I64) -> I64 -> I64
incCpp :: I64 -> I64
mapCpp :: (I64 -> I64) -> I64 -> I64
incR :: I64 -> I64
mapR :: (I64 -> I64) -> I64 -> I64
incRs :: I64 -> I64
mapRs :: (I64 -> I64) -> I64 -> I64

nativePy :: I64 -> I64
nativeCpp :: I64 -> I64
nativeR :: I64 -> I64
nativeRs :: I64 -> I64

-- <outer><Inner> n: the outer language's loop calls the inner function n times.
-- native<Lang> n: the same loop calling `inc` directly, without morloc.
pyPy n = mapPy incPy n
pyCpp n = mapPy incCpp n
pyR n = mapPy incR n
pyRs n = mapPy incRs n
cppPy n = mapCpp incPy n
cppCpp n = mapCpp incCpp n
cppR n = mapCpp incR n
cppRs n = mapCpp incRs n
rPy n = mapR incPy n
rCpp n = mapR incCpp n
rR n = mapR incR n
rRs n = mapR incRs n
rsPy n = mapRs incPy n
rsCpp n = mapRs incCpp n
rsR n = mapRs incR n
rsRs n = mapRs incRs n

-- Shaped payloads: an 8-field record, and a [F64] of m elements.
record Rec where
  ra :: I64
  rb :: F64
  rc :: I64
  rd :: F64
  re :: I64
  rf :: F64
  rg :: I64
  rh :: F64
record Cpp => Rec = "Rec"

source Py from "f.py" ("touch" as touchPy, "maprec" as mapRecPy, "vsum" as vsumPy, "mapvec" as mapVecPy)
source Cpp from "f.hpp" ("touch" as touchCpp, "maprec" as mapRecCpp, "vsum" as vsumCpp, "mapvec" as mapVecCpp)

touchPy :: Rec -> I64
mapRecPy :: (Rec -> I64) -> I64 -> I64
vsumPy :: [F64] -> F64
mapVecPy :: ([F64] -> F64) -> I64 -> I64 -> F64
touchCpp :: Rec -> I64
mapRecCpp :: (Rec -> I64) -> I64 -> I64
vsumCpp :: [F64] -> F64
mapVecCpp :: ([F64] -> F64) -> I64 -> I64 -> F64

-- <outer><Inner>Rec n: n calls, each crossing one record.
-- <outer><Inner>Vec m n: n calls, each crossing m F64s.
pyCppRec n = mapRecPy touchCpp n
cppPyRec n = mapRecCpp touchPy n
pyCppVec m n = mapVecPy vsumCpp m n
cppPyVec m n = mapVecCpp vsumPy m n
