module main (gatherCpp, controlCpp, gatherPy, controlPy, gatherCross, writeCpp, loadCpp, writePy, loadPy)

import root
import root-cpp
import root-py

source Cpp from "g.hpp" ("mk_hists" as mkHistsC, "summ" as summC, "count_hists" as countC)
source Py from "g.py" ("mk_hists" as mkHistsP, "summ" as summP, "count_hists" as countP)

mkHistsC :: I64 -> I64 -> [[U64]]
summC :: [[U64]] -> Str
countC :: [[U64]] -> I64
mkHistsP :: I64 -> I64 -> [[U64]]
summP :: [[U64]] -> Str
countP :: [[U64]] -> I64

produceC :: I64 -> I64 -> ([[U64]] -> <IO> ()) -> <IO> ()
produceC k b sink = ? b <= 0 = do
    ()
  : do
    _ <- sink (mkHistsC k b)
    produceC k (b - 1) sink

produceP :: I64 -> I64 -> ([[U64]] -> <IO> ()) -> <IO> ()
produceP k b sink = ? b <= 0 = do
    ()
  : do
    _ <- sink (mkHistsP k b)
    produceP k (b - 1) sink

loopC :: I64 -> I64 -> I64 -> <IO> I64
loopC k b acc = ? b <= 0 = do
    acc
  : do
    loopC k (b - 1) (acc + countC (mkHistsC k b))

loopP :: I64 -> I64 -> I64 -> <IO> I64
loopP k b acc = ? b <= 0 = do
    acc
  : do
    loopP k (b - 1) (acc + countP (mkHistsP k b))

--' C++ batches gathered whole into a C++ handler
--' @render -s/--sum=summC
gatherCpp :: I64 -> I64 -> <IO> (Collect [U64])
gatherCpp k b = @collect (produceC k b)

--' The C++ batches alone, each counted where it is made
controlCpp :: I64 -> I64 -> <IO> I64
controlCpp k b = loopC k b 0

--' Python batches gathered whole into a Python handler
--' @render -s/--sum=summP
gatherPy :: I64 -> I64 -> <IO> (Collect [U64])
gatherPy k b = @collect (produceP k b)

--' The Python batches alone, each counted where it is made
controlPy :: I64 -> I64 -> <IO> I64
controlPy k b = loopP k b 0

--' C++ batches gathered whole into a Python handler
--' @render -s/--sum=summP
gatherCross :: I64 -> I64 -> <IO> (Collect [U64])
gatherCross k b = @collect (produceC k b)

-- The gather's two halves, split at the file: write the batches to a
-- stream file, and load that file whole into the handler.
wr :: OStream [U64] -> [[U64]] -> <IO> ()
wr o xs = do
  Ok u <- @write 0 o xs
  u

--' C++ batches written to a stream file
writeCpp ::
  --' Histograms per batch
  I64 ->
  --' Batches
  I64 ->
  --' Stream file to write
  --' @check.path w
  Str ->
  <IO> ()
writeCpp k b path = do
  Ok o <- @open path :: <IO> (Try Str (OStream [U64]))
  produceC k b (wr o)
  @close o

--' A stream file loaded whole into a C++ handler
loadCpp ::
  --' Stream file to load
  --' @check.path r
  Str ->
  <IO> Str
loadCpp path = do
  Ok xs <- @load path
  summC xs

--' Python batches written to a stream file
writePy ::
  --' Histograms per batch
  I64 ->
  --' Batches
  I64 ->
  --' Stream file to write
  --' @check.path w
  Str ->
  <IO> ()
writePy k b path = do
  Ok o <- @open path :: <IO> (Try Str (OStream [U64]))
  produceP k b (wr o)
  @close o

--' A stream file loaded whole into a Python handler
loadPy ::
  --' Stream file to load
  --' @check.path r
  Str ->
  <IO> Str
loadPy path = do
  Ok xs <- @load path
  summP xs
