--' C++ IFile slices against an IStream @next loop
module main
  ( writeReals
  , writeStrs
  , sliceReals
  , sliceStrs
  , nextReals
  , nextStrs
  , pointsReals
  )

import root
import root-cpp

source Cpp from "gen.hpp" ("gen_reals" as genReals, "gen_strs" as genStrs)

genReals :: I64 -> [Real]
genStrs :: I64 -> [Str]

--' Write n Reals to a stream file at a compression level
writeReals :: Int -> I64 -> Str -> <IO> I64
writeReals z n path = do
  Ok o <- @open path :: <IO> (Try Str (OStream Real))
  @write z o (genReals n)
  @close o
  n

--' Write n Strs to a stream file at a compression level
writeStrs :: Int -> I64 -> Str -> <IO> I64
writeStrs z n path = do
  Ok o <- @open path :: <IO> (Try Str (OStream Str))
  @write z o (genStrs n)
  @close o
  n

--' Read the first n Reals of a file with one slice
sliceReals :: Int -> Str -> <IO> Int
sliceReals n path = do
  Ok f <- @open path :: <IO> (Try Str (IFile [Real]))
  length (.[0:n] f)

--' Read the first n Strs of a file with one slice
sliceStrs :: Int -> Str -> <IO> Int
sliceStrs n path = do
  Ok f <- @open path :: <IO> (Try Str (IFile [Str]))
  length (.[0:n] f)

countReals :: IStream Real -> Int -> <IO> Int
countReals s acc = do
  Ok xs <- @next s
  ? length xs == 0 = do
      acc
  : do
    countReals s (acc + length xs)

countStrs :: IStream Str -> Int -> <IO> Int
countStrs s acc = do
  Ok xs <- @next s
  ? length xs == 0 = do
      acc
  : do
    countStrs s (acc + length xs)

--' Read every Real of a file with an @next loop
nextReals :: Str -> <IO> Int
nextReals path = do
  Ok s <- @open path :: <IO> (Try Str (IStream Real))
  countReals s 0

--' Read every Str of a file with an @next loop
nextStrs :: Str -> <IO> Int
nextStrs path = do
  Ok s <- @open path :: <IO> (Try Str (IStream Str))
  countStrs s 0

one :: IFile [Real] -> Int -> Int -> Int
one f i j = length (.[i:j] f)

pointLoop :: IFile [Real] -> Int -> Int -> <IO> Int
pointLoop f k acc = ? k == 0 = do
    acc
  : do
    pointLoop f (k - 1) (acc + one f k (k + 1))

--' Read k one-element slices of a file of Reals
pointsReals :: Int -> Str -> <IO> Int
pointsReals k path = do
  Ok f <- @open path :: <IO> (Try Str (IFile [Real]))
  pointLoop f k 0
